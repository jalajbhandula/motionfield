{
  "_meta": {
    "name": "FLUX.2 klein 4B — product placement into a scene",
    "placeholders": {
      "PROMPT": "placement brief — how the product should sit in the scene",
      "INPUT_IMAGE": "scene image, comfy input/ filename",
      "SOURCE_FACE_IMAGE": "product image, comfy input/ filename (params.product_image_url)",
      "BBOX_X": "box left edge, normalised 0–1",
      "BBOX_Y": "box top edge, normalised 0–1",
      "BBOX_W": "box width, normalised 0–1",
      "BBOX_H": "box height, normalised 0–1",
      "REF_IMAGE": "optional extra reference #1",
      "REF_IMAGE_2": "optional extra reference #2",
      "REF_IMAGE_3": "optional extra reference #3 — the Mac graph uses the first 3 refs",
      "STEPS": "4 (distilled)",
      "SEED": "noise seed",
      "BATCH": "images per run",
      "PREFIX": "output filename prefix"
    },
    "optional": ["REF_IMAGE", "REF_IMAGE_2", "REF_IMAGE_3"],
    "requires": [
      "flux-2-klein-4b.safetensors",
      "qwen_3_4b_fp8_mixed.safetensors",
      "flux2-vae.safetensors",
      "birefnet.safetensors (background_removal)",
      "motionfield_nodes pack — OF_BoxPlace"
    ],
    "nodes": "core + OF_BoxPlace",
    "notes": "B17 path, native resolution: the product is BiRefNet-cut and OF_BoxPlace-pasted into the drawn box ON THE ORIGINAL scene (contain-fit, centred — aspect preserved). The composite is lanczos-scaled to ~1 MP as klein's reference (22), klein re-renders that frame as a harmonise pass, the decode is lanczos-scaled back to the scene's own size (38) and composited onto the ORIGINAL upload inside the grown+feathered box mask — pixels outside the region are the source's own. A last ImageCompositeMasked then pastes the placed composite back inside the product alpha eroded ~2 px, so the product's own pixels are kept verbatim and klein supplies only contact shadow, edge blend and the light around it."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "flux2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" } },
  "5": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["4", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{INPUT_IMAGE}}" } },
  "11": { "class_type": "GetImageSize", "inputs": { "image": ["10", 0] } },
  "13": { "class_type": "LoadImage", "inputs": { "image": "{{SOURCE_FACE_IMAGE}}" } },
  "14": { "class_type": "LoadBackgroundRemovalModel", "inputs": { "bg_removal_name": "birefnet.safetensors" } },
  "15": { "class_type": "RemoveBackground", "inputs": { "image": ["13", 0], "bg_removal_model": ["14", 0] } },
  "16": { "class_type": "InvertMask", "inputs": { "mask": ["15", 0] } },
  "17": { "class_type": "JoinImageWithAlpha", "inputs": { "image": ["13", 0], "alpha": ["16", 0] } },
  "18": { "class_type": "OF_BoxPlace", "inputs": { "image": ["10", 0], "overlay": ["17", 0], "bbox_x": "{{BBOX_X}}", "bbox_y": "{{BBOX_Y}}", "bbox_w": "{{BBOX_W}}", "bbox_h": "{{BBOX_H}}", "grow": 24, "feather": 24 } },
  "19": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "20": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_2}}" } },
  "21": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_3}}" } },
  "22": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["18", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16 } },
  "23": { "class_type": "GetImageSize", "inputs": { "image": ["22", 0] } },
  "30": { "class_type": "ReferenceMultiLatent", "inputs": {
    "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0],
    "resolution": "resize", "resolution.megapixels": 1.0,
    "images.image0": ["22", 0], "images.image1": ["19", 0], "images.image2": ["20", 0], "images.image3": ["21", 0]
  } },
  "31": { "class_type": "Flux2Scheduler", "inputs": { "steps": "{{STEPS}}", "width": ["23", 0], "height": ["23", 1] } },
  "32": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": ["23", 0], "height": ["23", 1], "batch_size": "{{BATCH}}" } },
  "33": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "34": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "35": { "class_type": "CFGGuider", "inputs": { "model": ["1", 0], "positive": ["30", 0], "negative": ["30", 1], "cfg": 1.0 } },
  "36": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["33", 0], "guider": ["35", 0], "sampler": ["34", 0], "sigmas": ["31", 0], "latent_image": ["32", 0] } },
  "37": { "class_type": "VAEDecode", "inputs": { "samples": ["36", 0], "vae": ["3", 0] } },
  "38": { "class_type": "ImageScale", "inputs": { "image": ["37", 0], "upscale_method": "lanczos", "width": ["11", 0], "height": ["11", 1], "crop": "disabled" } },
  "39": { "class_type": "ImageCompositeMasked", "inputs": { "destination": ["10", 0], "source": ["38", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["18", 1] } },
  "40": { "class_type": "GrowMask", "inputs": { "mask": ["18", 2], "expand": -2, "tapered_corners": true } },
  "41": { "class_type": "MaskToImage", "inputs": { "mask": ["40", 0] } },
  "42": { "class_type": "ImageBlur", "inputs": { "image": ["41", 0], "blur_radius": 2, "sigma": 1.0 } },
  "43": { "class_type": "ImageToMask", "inputs": { "image": ["42", 0], "channel": "red" } },
  "44": { "class_type": "ImageCompositeMasked", "inputs": { "destination": ["39", 0], "source": ["18", 0], "x": 0, "y": 0, "resize_source": false, "mask": ["43", 0] } },
  "45": { "class_type": "SaveImage", "inputs": { "images": ["44", 0], "filename_prefix": "{{PREFIX}}" } }
}
