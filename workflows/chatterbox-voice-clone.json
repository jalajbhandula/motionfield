{
  "_meta": {
    "name": "Chatterbox voice clone (reference audio + text)",
    "placeholders": {
      "INPUT_AUDIO": "uploaded reference voice clip (wav/mp3/flac)",
      "PROMPT": "text to speak in the cloned voice",
      "EXAGGERATION": "expressiveness 0.25-2.0 (0.5 neutral)",
      "SEED": "seed",
      "PREFIX": "filename prefix"
    },
    "requires": [
      "ComfyUI-Chatterbox (wildminder) + resemble-perth (watermark)"
    ],
    "nodes": "custom (ChatterboxTTS) + core LoadAudio/SaveAudio"
  },
  "1": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{INPUT_AUDIO}}"
    }
  },
  "2": {
    "class_type": "ChatterboxTTS",
    "inputs": {
      "model_pack_name": "resembleai_default_voice",
      "text": "{{PROMPT}}",
      "max_new_tokens": 1000,
      "flow_cfg_scale": 0.7,
      "exaggeration": "{{EXAGGERATION}}",
      "temperature": 0.8,
      "cfg_weight": 0.5,
      "repetition_penalty": 1.2,
      "min_p": 0.05,
      "top_p": 1.0,
      "seed": "{{SEED}}",
      "use_watermark": true,
      "device": "auto",
      "dtype": "auto",
      "attention_mode": "sdpa",
      "top_k": 1000,
      "normalize_loudness": true,
      "num_steps": 10,
      "cfg_scale": 1.0,
      "audio_prompt": ["1", 0]
    }
  },
  "3": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": ["2", 0],
      "filename_prefix": "{{PREFIX}}"
    }
  }
}
