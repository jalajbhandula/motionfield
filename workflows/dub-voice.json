{
  "_meta": {
    "name": "MotionField Dub — native-language line in the speaker's voice",
    "placeholders": {
      "INPUT_AUDIO": "speaker voice reference (clean speech from the source clip), comfy input/ filename",
      "PROMPT": "the translated line",
      "VOICE": "Kokoro base voice for the target language",
      "LANG": "Kokoro language name (Spanish, French, ...)",
      "SPEED": "Kokoro speed",
      "PREFIX": "output filename prefix"
    },
    "requires": [
      "custom-nodes: comfyui-kokoro (kokoro_v1.onnx + voices_v1.bin)",
      "custom-nodes: ComfyUI-Chatterbox (resembleai_default_voice: s3gen + ve)"
    ],
    "nodes": "KokoroSpeaker + KokoroGenerator speak the line natively in the target language → ChatterboxVC converts that speech onto the speaker's timbre (target_voice_audio = the reference) → SaveAudio."
  },
  "1": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{INPUT_AUDIO}}"
    }
  },
  "2": {
    "class_type": "KokoroSpeaker",
    "inputs": {
      "speaker_name": "{{VOICE}}"
    }
  },
  "3": {
    "class_type": "KokoroGenerator",
    "inputs": {
      "text": "{{PROMPT}}",
      "speaker": [
        "2",
        0
      ],
      "speed": "{{SPEED}}",
      "lang": "{{LANG}}"
    }
  },
  "4": {
    "class_type": "ChatterboxVC",
    "inputs": {
      "model_pack_name": "resembleai_default_voice",
      "source_audio": [
        "3",
        0
      ],
      "n_timesteps": 10,
      "temperature": 1.0,
      "flow_cfg_scale": 0.7,
      "use_watermark": true,
      "device": "default",
      "dtype": "auto",
      "attention_mode": "sdpa",
      "refinement_passes": 1,
      "max_chunk_duration": 30.0,
      "chunk_method": "smart",
      "target_voice_audio": [
        "1",
        0
      ]
    }
  },
  "5": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": [
        "4",
        0
      ],
      "filename_prefix": "{{PREFIX}}"
    }
  }
}
