{
  "_meta": {
    "name": "ACE-Step 1.5 — text to music",
    "desc": "Prompt-to-music on the ACE-Step 1.5 turbo DiT (Apache-2.0). Qwen3 0.6B encodes style+lyrics, the Qwen3 1.7B LM plans audio codes, turbo DiT samples 8 steps, 1.5 VAE decodes 48 kHz audio. OF_SaveAudioWav loudness-normalizes to −14 LUFS / −1 dBTP and ships the wav; the deprecated SaveAudio anchors the tail for the provider-side pruner, which only keeps nodes reachable from core output classes — its flac is dropped.",
    "placeholders": {
      "PROMPT": "style tags / music description",
      "LYRICS": "lyrics text (\"\" for instrumental — bound via the workflow map)",
      "DURATION": "seconds, 10–120",
      "SEED": "0 = random",
      "ACESTEP_UNET/CLIP1/CLIP2/VAE": "weight filenames — bound by the catalog map (see ACESTEP_FILES)",
      "PREFIX": "output filename prefix"
    },
    "drop_outputs": ["11"],
    "requires": ["acestep_v1.5_turbo.safetensors", "qwen_0.6b_ace15.safetensors", "qwen_1.7b_ace15.safetensors", "ace_1.5_vae.safetensors"],
    "custom_nodes": ["OF_SaveAudioWav"]
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{ACESTEP_UNET}}", "weight_dtype": "default" } },
  "2": { "class_type": "DualCLIPLoader", "inputs": { "clip_name1": "{{ACESTEP_CLIP1}}", "clip_name2": "{{ACESTEP_CLIP2}}", "type": "ace", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "{{ACESTEP_VAE}}" } },
  "4": { "class_type": "ModelSamplingAuraFlow", "inputs": { "shift": 3, "model": ["1", 0] } },
  "5": { "class_type": "TextEncodeAceStepAudio1.5", "inputs": {
    "clip": ["2", 0],
    "tags": "{{PROMPT}}",
    "lyrics": "{{LYRICS}}",
    "seed": "{{SEED}}",
    "bpm": 120,
    "duration": "{{DURATION}}",
    "timesignature": "4",
    "language": "en",
    "keyscale": "C major",
    "generate_audio_codes": true,
    "cfg_scale": 2.0,
    "temperature": 0.85,
    "top_p": 0.9,
    "top_k": 0,
    "min_p": 0
  } },
  "6": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["5", 0] } },
  "7": { "class_type": "EmptyAceStep1.5LatentAudio", "inputs": { "seconds": "{{DURATION}}", "batch_size": 1 } },
  "8": { "class_type": "KSampler", "inputs": {
    "model": ["4", 0],
    "positive": ["5", 0],
    "negative": ["6", 0],
    "latent_image": ["7", 0],
    "seed": "{{SEED}}",
    "steps": 8,
    "cfg": 1.0,
    "sampler_name": "euler",
    "scheduler": "simple",
    "denoise": 1.0
  } },
  "9": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["8", 0], "vae": ["3", 0] } },
  "10": { "class_type": "OF_SaveAudioWav", "inputs": { "audio": ["9", 0], "filename_prefix": "{{PREFIX}}", "lufs_target": -14.0, "true_peak": -1.0 } },
  "11": { "class_type": "SaveAudio", "inputs": { "audio": ["10", 0], "filename_prefix": "audio/of-mix-anchor" } }
}
