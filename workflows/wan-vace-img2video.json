{
 "_meta": {
  "name": "Wan 2.1 VACE 1.3B \u2014 image to video (first-frame control, Apache-2.0)",
  "placeholders": {
   "INPUT_IMAGE": "uploaded image filename (first frame / VACE reference)",
   "PROMPT": "motion/scene prompt",
   "NEGATIVE": "negative prompt",
   "WIDTH": "multiple of 32",
   "HEIGHT": "multiple of 32",
   "FRAMES": "frame count (4n+1)",
   "FPS": "output fps",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "PREFIX": "filename prefix"
  },
  "requires": [
   "wan2.1_vace_1.3B_fp16.safetensors (diffusion_models)",
   "umt5_xxl_fp8_e4m3fn_scaled.safetensors (text_encoders)",
   "wan_2.1_vae.safetensors (vae)",
   "custom-nodes: VideoHelperSuite (VHS_VideoCombine)"
  ],
  "nodes": "core + custom (VHS) \u2014 WanVaceToVideo first-frame i2v: INPUT_IMAGE drives control_video + reference_image; EmptyImage black/white batch -> ImageToMask -> control_masks"
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan_2.1_vae.safetensors"
  }
 },
 "4": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{PROMPT}}"
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{NEGATIVE}}"
  }
 },
 "6": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{INPUT_IMAGE}}"
  }
 },
 "7": {
  "class_type": "EmptyImage",
  "inputs": {
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "batch_size": 1,
   "color": 0
  }
 },
 "8": {
  "class_type": "EmptyImage",
  "inputs": {
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "batch_size": "{{FRAMES}}",
   "color": 16777215
  }
 },
 "9": {
  "class_type": "BatchImagesNode",
  "inputs": {
   "images.image0": [
    "7",
    0
   ],
   "images.image1": [
    "8",
    0
   ]
  }
 },
 "10": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "9",
    0
   ],
   "channel": "red"
  }
 },
 "11": {
  "class_type": "WanVaceToVideo",
  "inputs": {
   "positive": [
    "4",
    0
   ],
   "negative": [
    "5",
    0
   ],
   "vae": [
    "3",
    0
   ],
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "length": "{{FRAMES}}",
   "batch_size": 1,
   "strength": 1.0,
   "control_video": [
    "6",
    0
   ],
   "control_masks": [
    "10",
    0
   ],
   "reference_image": [
    "6",
    0
   ]
  }
 },
 "12": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "positive": [
    "11",
    0
   ],
   "negative": [
    "11",
    1
   ],
   "latent_image": [
    "11",
    2
   ],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "13": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "15",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "14": {
  "class_type": "VHS_VideoCombine",
  "inputs": {
   "images": [
    "13",
    0
   ],
   "frame_rate": "{{FPS}}",
   "loop_count": 0,
   "filename_prefix": "{{PREFIX}}",
   "format": "video/h264-mp4",
   "save_output": true,
   "pingpong": false
  }
 },
 "15": {
  "class_type": "TrimVideoLatent",
  "inputs": {
   "samples": [
    "12",
    0
   ],
   "trim_amount": [
    "11",
    3
   ]
  }
 }
}
