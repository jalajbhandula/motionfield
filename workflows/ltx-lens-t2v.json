    }
  },
  "107": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "101",
        0
      ],
      "shift": 3
    }
  },
  "108": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "107",
        0
      ],
      "positive": [
        "104",
        0
      ],
      "negative": [
        "105",
        0
      ],
      "latent_image": [
        "106",
        0
      ],
      "seed": "{{SEED}}",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "109": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "108",
        0
