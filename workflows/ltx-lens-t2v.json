{
  "_meta": {
    "name": "LTX-2.5 Lens text-to-video (still first, keyframed camera move)",
    "placeholders": {
      "PROMPT": "effect prompt (preset-injected)",
      "NEGATIVE": "negative prompt (encoded into the guider; distilled cfg is 1.0 so it is a no-op)",
      "END_FRAME": "pixel frame index the end keyframe pins (host sends frames-1; only resolved when END_IMAGE is set)",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "FRAMES": "8n+1",
      "FPS": "fps",
      "SEED": "noise seed",
      "PREFIX": "filename prefix",
      "STILL_PROMPT": "the scene prompt (no camera words) for the first-frame still",
      "Z_WIDTH": "still width, multiple of 32",
      "Z_HEIGHT": "still height, multiple of 32",
      "CROP_X": "end-keyframe crop x on the still",
      "CROP_Y": "end-keyframe crop y",
      "CROP_W": "end-keyframe crop width",
      "CROP_H": "end-keyframe crop height"
    },
    "requires": [
      "z_image_turbo_int8_convrot.safetensors (diffusion_models)",
      "qwen_3_4b_fp8_mixed.safetensors (text_encoders)",
      "ae.safetensors (vae)",
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors (diffusion_models)",
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors (text_encoders)",
      "ltx-2.5-video-vae-bf16.safetensors (vae)",
      "ltx-2.5-audio-vae-bf16.safetensors (vae)"
    ],
    "nodes": "core only",
    "notes": "Z-Image-Turbo renders the first frame at up to 2x the video size; ImageCrop cuts where the camera lands (lib/camera/keyframe-moves endCropRect) and both frames drive the official LTX-2.5 FLF2V keyframe recipe (see ltx-vfx-keyframe.json), so the move is executed, not prompted."
  },
  "101": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "102": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
