{
  "_meta": {
    "name": "Wan VACE object-swap (frame-0 pick + tracked matte)",
    "placeholders": {
      "PROMPT": "description incl. swapped object",
      "NEGATIVE": "negative prompt",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "FRAMES": "8n+1",
      "SEED": "noise seed",
      "STEPS": "20-30",
      "INPUT_VIDEO": "source video, comfy input/ filename",
      "MASK_IMAGE": "frame-0 pick \u2014 a white region painted/boxed on a black image at the clip's own dimensions (the object to replace on frame 0)",
      "REF_IMAGE": "replacement object reference image, comfy input/ filename",
      "PREFIX": "output filename prefix"
    },
    "requires": [
      "wan2.1_vace_1.3B_fp16.safetensors (upgrade: wan2.1_vace_14B_fp8scaled.safetensors on a GPU / Comfy Cloud)",
      "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "wan_2.1_vae.safetensors",
      "birefnet.safetensors (models/birefnet, MIT)",
      "custom-nodes: VideoHelperSuite (VHS_LoadVideo, VHS_VideoCombine), motionfield_nodes (OF_MaskTrack, OF_MatteCoverage, OF_PlateAudio)"
    ],
    "nodes": "core + VHS + motionfield_nodes",
    "notes": "Object swap without a mask video: BiRefNet mattes the whole clip per frame (every salient thing, not just people), and OF_MaskTrack keeps, on each later frame, only the part of that frame's matte that still overlaps the frame-0 pick \u2014 the tracked region follows the picked object while unrelated salient blobs never join the regen zone. A track that drops under 1% mean coverage raises inside the node, so a lost object fails the job with a clear message instead of regenerating at random. The tracked matte is grown + feathered into control_masks; control_video stays the source frames and the reference image supplies the replacement object \u2014 the unmasked region is preserved. Source audio is muxed back through OF_PlateAudio, which yields nothing when the clip has no audio stream instead of failing the job. The tracked matte frame and the per-frame coverage strip are saved as evidence."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{PROMPT}}"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{NEGATIVE}}"
    }
  },
  "6": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{{INPUT_VIDEO}}",
      "force_rate": 16,
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": "{{FRAMES}}",
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "9": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REF_IMAGE}}"
    }
  },
  "10": {
    "class_type": "WanVaceToVideo",
    "inputs": {
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "batch_size": 1,
      "strength": 1.0,
      "control_video": [
        "41",
        0
      ],
      "control_masks": [
        "21",
        0
      ],
      "reference_image": [
        "9",
        0
      ]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "10",
        0
      ],
      "negative": [
        "10",
        1
      ],
      "latent_image": [
        "10",
        2
      ],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "14",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "audio": [
        "26",
        0
      ],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "{{PREFIX}}",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "save_output": true,
      "pingpong": false
    }
  },
  "14": {
    "class_type": "TrimVideoLatent",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "trim_amount": [
        "10",
        3
      ]
    }
  },
  "15": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{MASK_IMAGE}}"
    }
  },
  "16": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "15",
        0
      ],
      "channel": "red"
    }
  },
  "17": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "18": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "17",
        0
      ],
      "image": [
        "6",
        0
      ]
    }
  },
  "19": {
    "class_type": "OF_MaskTrack",
    "inputs": {
      "matte": [
        "18",
        0
      ],
      "pick": [
        "16",
        0
      ],
      "min_coverage": 0.01,
      "overlap_px": 12
    }
  },
  "20": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "19",
        0
      ],
      "expand": 8,
      "tapered_corners": true
    }
  },
  "21": {
    "class_type": "FeatherMask",
    "inputs": {
      "mask": [
        "20",
        0
      ],
      "left": 10,
      "top": 10,
      "right": 10,
      "bottom": 10
    }
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "19",
        1
      ],
      "filename_prefix": "{{PREFIX}}"
    }
  },
  "23": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "21",
        0
      ]
    }
  },
  "24": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "23",
        0
      ],
      "batch_index": 0,
      "length": 1
    }
  },
  "25": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "24",
        0
      ],
      "filename_prefix": "{{PREFIX}}"
    }
  },
  "26": {
    "class_type": "OF_PlateAudio",
    "_meta": {
      "title": "source audio (silent-safe)"
    },
    "inputs": {
      "video": "{{INPUT_VIDEO}}",
      "start_time": 0,
      "duration": 0
    }
  },
  "40": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": "{{FRAMES}}",
      "color": 8421504
    },
    "_meta": {
      "title": "grey plate - VACE regenerates only what it cannot see"
    }
  },
  "41": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "6",
        0
      ],
      "source": [
        "40",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "21",
        0
      ]
    },
    "_meta": {
      "title": "grey out the tracked region"
    }
  }
}