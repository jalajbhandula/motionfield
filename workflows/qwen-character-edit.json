{
  "_meta": {
    "name": "Character — Qwen-Image-Edit-2509 multi-reference (cloud recommended)",
    "placeholders": {
      "PROMPT": "new scene/outfit description for the character",
      "WIDTH": "output width",
      "HEIGHT": "output height",
      "SEED": "seed",
      "STEPS": "steps",
      "BATCH": "images per run",
      "REF_IMAGE": "character reference image 1, comfy input/ filename",
      "REF_IMAGE_2": "optional second character ref",
      "REF_IMAGE_3": "optional third character ref",
      "PREFIX": "filename prefix"
    },
    "optional": ["REF_IMAGE_2", "REF_IMAGE_3"],
    "requires": [
      "qwen_image_edit_2511_fp8mixed.safetensors (diffusion_models)",
      "qwen_2.5_vl_7b_fp8_scaled.safetensors (text_encoders)",
      "qwen_image_vae.safetensors (vae)"
    ],
    "nodes": "core",
    "heavy": "~20B MMDiT + 7B VL encoder (~29 GB fp8) — Comfy Cloud or a CUDA GPU recommended; not practical on Apple Silicon 32 GB",
    "notes": "Multi-reference character via TextEncodeQwenImageEditPlus (the 2509 multi-image path): each ref gets its own vision token + VAE reference latent ('Picture 1/2/3: <image>' prompting convention). Refs 2-3 drop when unset. Free-sized EmptySD3LatentImage output; AuraFlow shift 3, CFGNorm 1.0, euler/simple."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "qwen_image_edit_2511_fp8mixed.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "qwen_image_vae.safetensors" } },
  "4": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "5": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_2}}" } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_3}}" } },
  "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": {
    "clip": ["2", 0], "vae": ["3", 0],
    "image1": ["4", 0], "image2": ["5", 0], "image3": ["6", 0],
    "prompt": "{{PROMPT}}"
  } },
  "8": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["2", 0], "vae": ["3", 0], "image1": ["4", 0], "prompt": "" } },
  "9": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": "{{BATCH}}" } },
  "10": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.0 } },
  "11": { "class_type": "CFGNorm", "inputs": { "model": ["10", 0], "strength": 1.0 } },
  "12": { "class_type": "KSampler", "inputs": {
    "model": ["11", 0], "positive": ["15", 0], "negative": ["16", 0], "latent_image": ["9", 0],
    "seed": "{{SEED}}", "steps": "{{STEPS}}", "cfg": 4.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0
  } },
  "13": { "class_type": "VAEDecode", "inputs": { "samples": ["12", 0], "vae": ["3", 0] } },
  "14": { "class_type": "SaveImage", "inputs": { "images": ["13", 0], "filename_prefix": "{{PREFIX}}" } },
  "15": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["7", 0], "reference_latents_method": "index_timestep_zero" } },
  "16": { "class_type": "FluxKontextMultiReferenceLatentMethod", "inputs": { "conditioning": ["8", 0], "reference_latents_method": "index_timestep_zero" } }
}
