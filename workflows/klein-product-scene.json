{
  "_meta": {
    "name": "FLUX.2 klein 4B — product into a generated scene (no plate)",
    "placeholders": {
      "PROMPT": "scene/brief text (catalog map prepends the product-placement instruction)",
      "SOURCE_FACE_IMAGE": "product image, comfy input/ filename (params.product_image_url)",
      "REF_IMAGE": "optional extra reference #1",
      "REF_IMAGE_2": "optional extra reference #2",
      "REF_IMAGE_3": "optional extra reference #3 — the Mac graph uses the first 3 refs",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "STEPS": "4 (distilled)",
      "SEED": "noise seed",
      "BATCH": "images per run",
      "PREFIX": "output filename prefix"
    },
    "optional": ["REF_IMAGE", "REF_IMAGE_2", "REF_IMAGE_3"],
    "requires": [
      "flux-2-klein-4b.safetensors",
      "qwen_3_4b_fp8_mixed.safetensors",
      "flux2-vae.safetensors"
    ],
    "nodes": "core only",
    "notes": "The no-plate arm of motionfield/product-placement (picked via workflowFor when no image_url is supplied): the product photo goes straight to the reference-latent chain and klein generates the scene around it. Used by Ad Lab and the packshot tile — 'place your product into generated scenes'. The boxed-composite arm (klein-product-compose.json) is the pixel-exact path."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "flux2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" } },
  "5": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["4", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{SOURCE_FACE_IMAGE}}" } },
  "15": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "16": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_2}}" } },
  "17": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_3}}" } },
  "20": { "class_type": "ReferenceMultiLatent", "inputs": {
    "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0],
    "resolution": "resize", "resolution.megapixels": 1.0,
    "images.image0": ["10", 0], "images.image1": ["15", 0], "images.image2": ["16", 0], "images.image3": ["17", 0]
  } },
  "21": { "class_type": "Flux2Scheduler", "inputs": { "steps": "{{STEPS}}", "width": "{{WIDTH}}", "height": "{{HEIGHT}}" } },
  "22": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": "{{BATCH}}" } },
  "23": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "24": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "25": { "class_type": "CFGGuider", "inputs": { "model": ["1", 0], "positive": ["20", 0], "negative": ["20", 1], "cfg": 1.0 } },
  "26": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["23", 0], "guider": ["25", 0], "sampler": ["24", 0], "sigmas": ["21", 0], "latent_image": ["22", 0] } },
  "27": { "class_type": "VAEDecode", "inputs": { "samples": ["26", 0], "vae": ["3", 0] } },
  "28": { "class_type": "SaveImage", "inputs": { "images": ["27", 0], "filename_prefix": "{{PREFIX}}" } }
}
