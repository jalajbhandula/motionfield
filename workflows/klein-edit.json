{
  "_meta": {
    "name": "FLUX.2 klein 4B — instruction edit (distilled)",
    "placeholders": {
      "PROMPT": "edit instruction — describe the change",
      "INPUT_IMAGE": "image to edit, comfy input/ filename",
      "REF_IMAGE": "optional extra reference #1 (style/identity)",
      "REF_IMAGE_2": "optional extra reference #2",
      "REF_IMAGE_3": "optional extra reference #3 — the Mac graph uses the first 3 refs",
      "STEPS": "4 (distilled)",
      "SEED": "noise seed",
      "BATCH": "images per run",
      "PREFIX": "output filename prefix"
    },
    "optional": ["REF_IMAGE", "REF_IMAGE_2", "REF_IMAGE_3"],
    "requires": [
      "flux-2-klein-4b.safetensors",
      "qwen_3_4b_fp8_mixed.safetensors",
      "flux2-vae.safetensors"
    ],
    "nodes": "core only",
    "notes": "Mirrors the official image_flux2_klein_image_edit_4b_distilled template: input image is lanczos-scaled to 1 MP and fed as the reference latent via ReferenceMultiLatent (image0 = the edit target, image1..3 = optional extra refs; a dropped ref loader just leaves its autogrow input empty). Native SamplerCustomAdvanced stack: Flux2Scheduler + euler + CFGGuider cfg=1, 4-step distilled default."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "flux2" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["2", 0], "text": "{{PROMPT}}" } },
  "5": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["4", 0] } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{INPUT_IMAGE}}" } },
  "11": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["10", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16 } },
  "12": { "class_type": "GetImageSize", "inputs": { "image": ["11", 0] } },
  "13": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE}}" } },
  "14": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_2}}" } },
  "15": { "class_type": "LoadImage", "inputs": { "image": "{{REF_IMAGE_3}}" } },
  "20": { "class_type": "ReferenceMultiLatent", "inputs": {
    "positive": ["4", 0], "negative": ["5", 0], "vae": ["3", 0],
    "resolution": "resize", "resolution.megapixels": 1.0,
    "images.image0": ["11", 0], "images.image1": ["13", 0], "images.image2": ["14", 0], "images.image3": ["15", 0]
  } },
  "21": { "class_type": "Flux2Scheduler", "inputs": { "steps": "{{STEPS}}", "width": ["12", 0], "height": ["12", 1] } },
  "22": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": ["12", 0], "height": ["12", 1], "batch_size": "{{BATCH}}" } },
  "23": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "24": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "25": { "class_type": "CFGGuider", "inputs": { "model": ["1", 0], "positive": ["20", 0], "negative": ["20", 1], "cfg": 1.0 } },
  "26": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["23", 0], "guider": ["25", 0], "sampler": ["24", 0], "sigmas": ["21", 0], "latent_image": ["22", 0] } },
  "27": { "class_type": "VAEDecode", "inputs": { "samples": ["26", 0], "vae": ["3", 0] } },
  "28": { "class_type": "SaveImage", "inputs": { "images": ["27", 0], "filename_prefix": "{{PREFIX}}" } }
}
