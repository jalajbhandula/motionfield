{
 "_meta": {
  "name": "MotionField CameraRig — image to video (Wan VACE, trajectory-driven)",
  "placeholders": {
   "INPUT_IMAGE": "uploaded image filename (start frame)",
   "MOVES": "'+'-joined trajectory stack (1-3 catalog ids)",
   "PROMPT": "motion/scene prompt",
   "NEGATIVE": "negative prompt",
   "DURATION": "shot length, seconds (integer)",
   "STRENGTH": "trajectory strength 0.25-2",
   "DISTANCE": "subject distance, metres (sets the depth scale)",
   "FOV": "camera horizontal fov, degrees",
   "CAM_W": "rig/vace width (multiple of 16)",
   "CAM_H": "rig/vace height (multiple of 16)",
   "CAM_FRAMES": "frame count = duration*16+1 (VACE 4n+1)",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "FPS": "output fps (16 — matches the pose stream)",
   "PREFIX": "filename prefix"
  },
  "requires": [
   "wan2.1_vace_1.3B_fp16.safetensors (diffusion_models)",
   "umt5_xxl_fp8_e4m3fn_scaled.safetensors (text_encoders)",
   "wan_2.1_vae.safetensors (vae)",
   "depth_anything_3_mono_large.safetensors (geometry_estimation)",
   "custom-nodes: VideoHelperSuite (VHS_VideoCombine)",
   "custom-nodes: motionfield_nodes (OF_Trajectory, OF_CameraRig)"
  ],
  "nodes": "OF_Trajectory emits the pose stream; LoadDA3Model+DA3Inference+DA3Render (raw) supply the start frame's depth; OF_CameraRig re-renders the frame along the poses (rgb/holes/control); WanVaceToVideo generates with control_video=control, control_masks=holes, reference_image=start frame."
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan_2.1_vae.safetensors"
  }
 },
 "4": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{PROMPT}}"
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "2",
    0
   ],
   "text": "{{NEGATIVE}}"
  }
 },
 "6": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{INPUT_IMAGE}}"
  }
 },
 "7": {
  "class_type": "OF_Trajectory",
  "inputs": {
   "trajectory": "locked-off",
   "moves": "{{MOVES}}",
   "strength": "{{STRENGTH}}",
   "duration": "{{DURATION}}",
   "fps": "{{FPS}}",
   "seed": "{{SEED}}",
   "target": "auto",
   "layer": "auto",
   "post": "auto",
   "subject_class": "person",
   "distance": "{{DISTANCE}}",
   "fov": "{{FOV}}"
  }
 },
 "8": {
  "class_type": "LoadDA3Model",
  "inputs": {
   "model_name": "depth_anything_3_mono_large.safetensors",
   "weight_dtype": "default"
  }
 },
 "9": {
  "class_type": "DA3Inference",
  "inputs": {
   "da3_model": [
    "8",
    0
   ],
   "image": [
    "6",
    0
   ],
   "resolution": 518,
   "resize_method": "upper_bound_resize",
   "mode": "mono"
  }
 },
 "10": {
  "class_type": "DA3Render",
  "inputs": {
   "da3_geometry": [
    "9",
    0
   ],
   "output": "depth",
   "output.normalization": "raw",
   "output.apply_sky_clip": true
  }
 },
 "11": {
  "class_type": "OF_CameraRig",
  "inputs": {
   "source": [
    "6",
    0
   ],
   "depth": [
    "10",
    0
   ],
   "poses_json": [
    "7",
    0
   ],
   "near": 0.05,
   "hole_dilate": 8,
   "distance": "{{DISTANCE}}",
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "depth_mode": "auto"
  }
 },
 "12": {
  "class_type": "WanVaceToVideo",
  "inputs": {
   "positive": [
    "4",
    0
   ],
   "negative": [
    "5",
    0
   ],
   "vae": [
    "3",
    0
   ],
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "length": "{{CAM_FRAMES}}",
   "batch_size": 1,
   "strength": 1.0,
   "control_video": [
    "11",
    2
   ],
   "control_masks": [
    "11",
    1
   ],
   "reference_image": [
    "6",
    0
   ]
  }
 },
 "13": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "positive": [
    "12",
    0
   ],
   "negative": [
    "12",
    1
   ],
   "latent_image": [
    "12",
    2
   ],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "14": {
  "class_type": "TrimVideoLatent",
  "inputs": {
   "samples": [
    "13",
    0
   ],
   "trim_amount": [
    "12",
    3
   ]
  }
 },
 "15": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "14",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "16": {
  "class_type": "VHS_VideoCombine",
  "inputs": {
   "images": [
    "15",
    0
   ],
   "frame_rate": "{{FPS}}",
   "loop_count": 0,
   "filename_prefix": "{{PREFIX}}",
   "format": "video/h264-mp4",
   "save_output": true,
   "pingpong": false
  }
 }
}
