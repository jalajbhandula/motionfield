{
 "_meta": {
  "name": "MotionField Director — text to video (Z-Image keyframe → Wan2.1-Fun camera)",
  "placeholders": {
   "KEYFRAME_PROMPT": "start-frame prompt — the user's scene text",
   "MOVES": "'+'-joined executable trajectory stack (1-3 catalog ids)",
   "PROMPT": "assembled scene prompt (user text + style clauses)",
   "NEGATIVE": "negative prompt",
   "DURATION": "shot length, seconds (integer 1-5)",
   "STRENGTH": "trajectory strength 0.25-2",
   "DISTANCE": "subject distance, metres (aim point for the pose stream)",
   "FOV": "camera horizontal fov, degrees (lens mm + sensor)",
   "CAM_W": "output width (multiple of 16, 480p)",
   "CAM_H": "output height (multiple of 16, 480p)",
   "KF_W": "keyframe width (2x cam width, multiple of 16)",
   "KF_H": "keyframe height (2x cam height, multiple of 16)",
   "CAM_SCALE": "camera-embedding translation scale (canonical range vs metres)",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "FPS": "output fps (16 — matches the pose stream)",
   "PREFIX": "filename prefix",
   "KEYFRAME_PREFIX": "keyframe SaveImage filename prefix (job-unique, from directorPlaceholders — never PREFIX)"
  },
  "requires": [
   "z_image_turbo_int8_convrot.safetensors (diffusion_models — keyframe)",
   "qwen_3_4b_fp8_mixed.safetensors (text_encoders — keyframe)",
   "ae.safetensors (vae — keyframe)",
   "wan2.1_fun_camera_v1.1_1.3B_bf16.safetensors (diffusion_models)",
   "umt5_xxl_fp8_e4m3fn_scaled.safetensors (text_encoders)",
   "wan_2.1_vae.safetensors (vae)",
   "custom-nodes: VideoHelperSuite (VHS_VideoCombine)",
   "custom-nodes: motionfield_nodes (OF_Trajectory, OF_CameraEmbed)"
  ],
  "nodes": "text-only director on the Fun camera path: Z-Image-Turbo renders the first frame at 2x cam size, then OF_Trajectory poses + OF_CameraEmbed Plücker conditioning drive WanCameraImageToVideo. No clip_vision (not installed), no refgrid/aperture DoF — WanCameraImageToVideo has no reference input and this path carries no depth. Everything in the graph is Apache-2.0. Status: cloud-recommended, untested on this machine (clip_vision_h absent; no local render evidence yet).",
  "drop_outputs": ["30"]
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.1_fun_camera_v1.1_1.3B_bf16.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan_2.1_vae.safetensors"
  }
 },
 "4": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["2", 0],
   "text": "{{PROMPT}}"
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["2", 0],
   "text": "{{NEGATIVE}}"
  }
 },
 "6": {
  "class_type": "OF_Trajectory",
  "inputs": {
   "trajectory": "locked-off",
   "moves": "{{MOVES}}",
   "strength": "{{STRENGTH}}",
   "duration": "{{DURATION}}",
   "fps": "{{FPS}}",
   "seed": "{{SEED}}",
   "target": "auto",
   "layer": "auto",
   "post": "auto",
   "subject_class": "person",
   "distance": "{{DISTANCE}}",
   "fov": "{{FOV}}"
  }
 },
 "17": {
  "class_type": "OF_CameraEmbed",
  "inputs": {
   "poses_json": ["6", 0],
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "translation_scale": "{{CAM_SCALE}}"
  }
 },
 "20": {
  "class_type": "WanCameraImageToVideo",
  "inputs": {
   "positive": ["4", 0],
   "negative": ["5", 0],
   "vae": ["3", 0],
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "length": ["17", 3],
   "batch_size": 1,
   "start_image": ["23", 0],
   "camera_conditions": ["17", 0]
  }
 },
 "21": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["1", 0],
   "positive": ["20", 0],
   "negative": ["20", 1],
   "latent_image": ["20", 2],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "22": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["21", 0],
   "vae": ["3", 0]
  }
 },
 "28": {
  "class_type": "VHS_VideoCombine",
  "inputs": {
   "images": ["22", 0],
   "frame_rate": "{{FPS}}",
   "loop_count": 0,
   "filename_prefix": "{{PREFIX}}",
   "format": "video/h264-mp4",
   "save_output": true,
   "pingpong": false
  }
 },
 "23": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["29", 0],
   "vae": ["26", 0]
  }
 },
 "24": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "z_image_turbo_int8_convrot.safetensors",
   "weight_dtype": "default"
  }
 },
 "25": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
   "type": "lumina2",
   "device": "default"
  }
 },
 "26": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ae.safetensors"
  }
 },
 "27": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["25", 0],
   "text": "{{KEYFRAME_PROMPT}}"
  }
 },
 "29": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["31", 0],
   "positive": ["27", 0],
   "negative": ["32", 0],
   "latent_image": ["33", 0],
   "seed": "{{SEED}}",
   "steps": 8,
   "cfg": 1.0,
   "sampler_name": "res_multistep",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "30": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["23", 0],
   "filename_prefix": "{{KEYFRAME_PREFIX}}"
  }
 },
 "31": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": ["24", 0],
   "shift": 3
  }
 },
 "32": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": ["27", 0]
  }
 },
 "33": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": "{{KF_W}}",
   "height": "{{KF_H}}",
   "batch_size": 1
  }
 }
}
