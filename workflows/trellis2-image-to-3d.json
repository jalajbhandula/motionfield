{
  "_meta": {
    "name": "TRELLIS.2 image-to-3D (textured GLB)",
    "placeholders": {
      "INPUT_IMAGE": "uploaded subject image",
      "SEED": "structure-stage noise seed",
      "SEED_SHAPE": "shape-stage seed (map: SEED+1)",
      "SEED_UP": "upsample-stage seed (map: SEED+2)",
      "SEED_TEX": "texture-stage seed (map: SEED+3)",
      "UPRES": "upsample target voxel resolution (512-2048, step 128)",
      "FACES": "decimation target face count (0 disables)",
      "PREFIX": "output filename prefix"
    },
    "requires": [
      "trellis_2_int8_convrot.safetensors (diffusion_models)",
      "trellis_2_shape_vae_bf16.safetensors (vae)",
      "trellis_2_texture_vae_bf16.safetensors (vae)",
      "dino_v3_L_naf_fp32.safetensors (clip_vision)",
      "birefnet.safetensors (background_removal)"
    ],
    "nodes": "core (ComfyUI 0.41 native 3D stack)",
    "notes": "Faithful port of the official ComfyUI 3d_pixal3d_trellis2_image_to_model template, TRELLIS.2 branch only: BiRefNet background removal -> ImageCropToMask (pad_factor 1.0 per the Trellis2Conditioning tooltip) -> DINOv3-NAF conditioning -> structure KSampler (12 steps, cfg 7.5, CFGOverride 0.667-1.0 + RescaleCFG 0.7 + ModelSamplingSD3 shift 5) -> VaeDecodeStructureTrellis2@32 -> shape stage (20 steps) -> VaeDecodeShapeTrellis -> upsample stage to 1536 voxels (12 steps, simple scheduler) -> hi-res shape decode -> texture stage (12 steps, cfg 1 on the raw model) -> VaeDecodeTextureTrellis -> Remesh 768/udf -> Decimate -> smooth normals -> Unwrap pec@4096 -> bake base/metallic/roughness from voxels + normal map + AO from the hi-res remesh -> ApplyTextureToMesh -> MeshToFile3D -> Save3DAdvanced (GLB) + RenderMesh preview PNG. MoGe/Pixal3D nodes omitted: in the official template MoGeGeometryToFOV feeds only Pixal3DConditioning.camera_angle_x — TRELLIS.2 conditioning is FOV-free."
  },
  "1":  { "class_type": "LoadImage", "inputs": { "image": "{{INPUT_IMAGE}}" } },
  "2":  { "class_type": "LoadBackgroundRemovalModel", "inputs": { "bg_removal_name": "birefnet.safetensors" } },
  "3":  { "class_type": "RemoveBackground", "inputs": { "bg_removal_model": ["2", 0], "image": ["1", 0] } },
  "4":  { "class_type": "ImageCropToMask", "inputs": { "images": ["1", 0], "masks": ["3", 0], "width": 1024, "height": 1024, "pad_factor": 1.0, "grow_mask": 0, "background": "#000000" } },
  "5":  { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "dino_v3_L_naf_fp32.safetensors" } },
  "6":  { "class_type": "Trellis2Conditioning", "inputs": { "clip_vision_model": ["5", 0], "image": ["4", 0] } },
  "7":  { "class_type": "UNETLoader", "inputs": { "unet_name": "trellis_2_int8_convrot.safetensors", "weight_dtype": "default" } },
  "8":  { "class_type": "CFGOverride", "inputs": { "model": ["7", 0], "cfg": 1, "start_percent": 0.667, "end_percent": 1 } },
  "9":  { "class_type": "RescaleCFG", "inputs": { "model": ["8", 0], "multiplier": 0.7 } },
  "10": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["9", 0], "shift": 5 } },
  "11": { "class_type": "EmptyTrellis2LatentStructure", "inputs": { "batch_size": 1 } },
  "12": { "class_type": "KSampler", "inputs": { "model": ["10", 0], "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["11", 0], "seed": "{{SEED}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "13": { "class_type": "VAELoader", "inputs": { "vae_name": "trellis_2_shape_vae_bf16.safetensors" } },
  "14": { "class_type": "VaeDecodeStructureTrellis2", "inputs": { "samples": ["12", 0], "vae": ["13", 0], "resolution": "32" } },
  "15": { "class_type": "Trellis2ShapeStage", "inputs": { "positive": ["6", 0], "negative": ["6", 1], "voxel": ["14", 0] } },
  "16": { "class_type": "CFGOverride", "inputs": { "model": ["7", 0], "cfg": 1, "start_percent": 0.769, "end_percent": 1 } },
  "17": { "class_type": "RescaleCFG", "inputs": { "model": ["16", 0], "multiplier": 0.5 } },
  "18": { "class_type": "KSampler", "inputs": { "model": ["17", 0], "positive": ["15", 0], "negative": ["15", 1], "latent_image": ["15", 2], "seed": "{{SEED_SHAPE}}", "steps": 20, "cfg": 7.5, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "19": { "class_type": "VaeDecodeShapeTrellis", "inputs": { "samples": ["18", 0], "vae": ["13", 0] } },
  "20": { "class_type": "Trellis2UpsampleStage", "inputs": { "positive": ["15", 0], "negative": ["15", 1], "shape_latent": ["18", 0], "vae": ["13", 0], "target_resolution": "{{UPRES}}" } },
  "21": { "class_type": "KSampler", "inputs": { "model": ["17", 0], "positive": ["20", 0], "negative": ["20", 1], "latent_image": ["20", 2], "seed": "{{SEED_UP}}", "steps": 12, "cfg": 7.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
  "22": { "class_type": "VaeDecodeShapeTrellis", "inputs": { "samples": ["21", 0], "vae": ["13", 0] } },
  "23": { "class_type": "Trellis2TextureStage", "inputs": { "positive": ["20", 0], "negative": ["20", 1], "shape_latent": ["21", 0] } },
  "24": { "class_type": "KSampler", "inputs": { "model": ["7", 0], "positive": ["23", 0], "negative": ["23", 1], "latent_image": ["23", 2], "seed": "{{SEED_TEX}}", "steps": 12, "cfg": 1, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0 } },
  "25": { "class_type": "VAELoader", "inputs": { "vae_name": "trellis_2_texture_vae_bf16.safetensors" } },
  "26": { "class_type": "VaeDecodeTextureTrellis", "inputs": { "samples": ["24", 0], "vae": ["25", 0], "shape_subdivides": ["22", 1] } },
  "27": { "class_type": "GetMeshInfo", "inputs": { "mesh": ["22", 0] } },
  "28": { "class_type": "RemeshMesh", "inputs": { "mesh": ["27", 0], "resolution": 768, "sign_mode": "udf", "sign_mode.qef": false, "sign_mode.drop_inverted_components": false, "sign_mode.drop_enclosed_components": false, "band": 1.0, "project_back": 0.0, "fix_poles": false, "smooth_iters": 20, "drop_small_components": 0.01, "precluster_max_verts": 20000000 } },
  "29": { "class_type": "DecimateMesh", "inputs": { "mesh": ["28", 0], "target_face_count": "{{FACES}}", "placement_mode": "midpoint" } },
  "30": { "class_type": "MeshSmoothNormals", "inputs": { "mesh": ["29", 0], "crease_angle": 180.0 } },
  "31": { "class_type": "UnwrapMesh", "inputs": { "mesh": ["30", 0], "segmenter": "pec", "resolution": 4096, "padding": 1, "weld_distance": 0.0002 } },
  "32": { "class_type": "BakeTextureFromVoxel", "inputs": { "mesh": ["31", 0], "voxel_colors": ["26", 0], "reference_mesh": ["22", 0], "texture_size": 4096 } },
  "33": { "class_type": "BakeNormalMapFromMesh", "inputs": { "low_poly": ["31", 0], "high_poly": ["28", 0], "resolution": 2048, "cage_distance": 0.05, "ignore_backfaces": true } },
  "34": { "class_type": "BakeAmbientOcclusion", "inputs": { "low_poly": ["31", 0], "high_poly": ["28", 0], "resolution": 1024, "samples": 64, "max_distance": 0.71, "strength": 1.0, "bias": 0.01 } },
  "35": { "class_type": "ApplyTextureToMesh", "inputs": { "mesh": ["31", 0], "base_color": ["32", 0], "metallic": ["32", 1], "roughness": ["32", 2], "occlusion": ["34", 0], "normal_map": ["33", 0] } },
  "36": { "class_type": "MeshSmoothNormals", "inputs": { "mesh": ["35", 0], "crease_angle": 180.0 } },
  "37": { "class_type": "MeshToFile3D", "inputs": { "mesh": ["36", 0] } },
  "38": { "class_type": "Save3DAdvanced", "inputs": { "model_3d": ["37", 0], "filename_prefix": "{{PREFIX}}", "viewport_state": "", "width": 1024, "height": 1024 } },
  "39": { "class_type": "RenderMesh", "inputs": { "mesh": ["35", 0], "mode": "texture", "width": 1024, "height": 1024, "background": "#101018" } },
  "40": { "class_type": "SaveImage", "inputs": { "images": ["39", 0], "filename_prefix": "{{PREFIX}}" } }
}
