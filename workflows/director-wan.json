{
 "_meta": {
  "name": "MotionField Director — image to video (Wan VACE 1.3B, trajectory rig)",
  "placeholders": {
   "INPUT_IMAGE": "uploaded image filename (start frame — the rig unprojects it)",
   "REF_IMAGE": "optional reference image 1 — stitched onto the start frame",
   "REF_IMAGE_2": "optional reference image 2",
   "REF_IMAGE_3": "optional reference image 3",
   "MOVES": "'+'-joined executable trajectory stack (1-3 catalog ids)",
   "PROMPT": "assembled scene prompt (user text + style clauses)",
   "NEGATIVE": "negative prompt",
   "DURATION": "shot length, seconds (integer 1-5)",
   "STRENGTH": "trajectory strength 0.25-2",
   "DISTANCE": "subject distance, metres (depth scale + DoF focus)",
   "FOV": "camera horizontal fov, degrees (lens mm + sensor)",
   "APERTURE": "OF_DepthBlur blur strength (f-stop preset, 0-24)",
   "CAM_W": "rig/vace width (multiple of 16, 480p)",
   "CAM_H": "rig/vace height (multiple of 16, 480p)",
   "CAM_FRAMES": "frame count = duration*16+1 (VACE 4n+1)",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "FPS": "output fps (16 — matches the pose stream)",
   "PREFIX": "filename prefix",
   "REFGRID_PREFIX": "refgrid SaveImage filename prefix (job-unique, from directorPlaceholders — never PREFIX)"
  },
  "optional": ["REF_IMAGE", "REF_IMAGE_2", "REF_IMAGE_3"],
  "requires": [
   "wan2.1_vace_1.3B_fp16.safetensors (diffusion_models)",
   "umt5_xxl_fp8_e4m3fn_scaled.safetensors (text_encoders)",
   "wan_2.1_vae.safetensors (vae)",
   "depth_anything_3_mono_large.safetensors (geometry_estimation)",
   "custom-nodes: VideoHelperSuite (VHS_VideoCombine)",
   "custom-nodes: motionfield_nodes (OF_Trajectory, OF_DirectorRig, OF_DepthBlur)"
  ],
  "nodes": "cam-i2v's proven chain + the director's controls: OF_Trajectory poses the move; DA3 (mono-large, Apache-2.0) supplies start-frame depth; OF_DirectorRig re-renders along the poses with depth-edge filtering and pinhole fill (control_video=control, control_masks=holes); Wan VACE generates; OF_DepthBlur applies aperture/focus DoF over the decoded frames (poses_json carries per-frame focus pulls); references stitch in a row after the start frame (dropped optional loaders pass the chain through, so 0 refs leaves the bare start frame) and ResizeAndPadImage letterboxes the composite to CAM_W×CAM_H before reference_image.",
  "drop_outputs": ["26"]
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
   "type": "wan",
   "device": "default"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "wan_2.1_vae.safetensors"
  }
 },
 "4": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["2", 0],
   "text": "{{PROMPT}}"
  }
 },
 "5": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["2", 0],
   "text": "{{NEGATIVE}}"
  }
 },
 "6": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{INPUT_IMAGE}}"
  }
 },
 "7": {
  "class_type": "OF_Trajectory",
  "inputs": {
   "trajectory": "locked-off",
   "moves": "{{MOVES}}",
   "strength": "{{STRENGTH}}",
   "duration": "{{DURATION}}",
   "fps": "{{FPS}}",
   "seed": "{{SEED}}",
   "target": "auto",
   "layer": "auto",
   "post": "auto",
   "subject_class": "person",
   "distance": "{{DISTANCE}}",
   "fov": "{{FOV}}"
  }
 },
 "8": {
  "class_type": "LoadDA3Model",
  "inputs": {
   "model_name": "depth_anything_3_mono_large.safetensors",
   "weight_dtype": "default"
  }
 },
 "9": {
  "class_type": "DA3Inference",
  "inputs": {
   "da3_model": ["8", 0],
   "image": ["6", 0],
   "resolution": 518,
   "resize_method": "upper_bound_resize",
   "mode": "mono"
  }
 },
 "10": {
  "class_type": "DA3Render",
  "inputs": {
   "da3_geometry": ["9", 0],
   "output": "depth",
   "output.normalization": "raw",
   "output.apply_sky_clip": true
  }
 },
 "11": {
  "class_type": "OF_DirectorRig",
  "inputs": {
   "source": ["6", 0],
   "depth": ["10", 0],
   "poses_json": ["7", 0],
   "near": 0.05,
   "hole_dilate": 6,
   "distance": "{{DISTANCE}}",
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "depth_mode": "auto",
   "edge_ratio": 1.8,
   "spike_ratio": 2.2,
   "fill_iters": 8,
   "radius_max": 10
  }
 },
 "12": {
  "class_type": "WanVaceToVideo",
  "inputs": {
   "positive": ["4", 0],
   "negative": ["5", 0],
   "vae": ["3", 0],
   "width": "{{CAM_W}}",
   "height": "{{CAM_H}}",
   "length": "{{CAM_FRAMES}}",
   "batch_size": 1,
   "strength": 1.0,
   "control_video": ["11", 2],
   "control_masks": ["11", 1],
   "reference_image": ["25", 0]
  }
 },
 "13": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["1", 0],
   "positive": ["12", 0],
   "negative": ["12", 1],
   "latent_image": ["12", 2],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "14": {
  "class_type": "TrimVideoLatent",
  "inputs": {
   "samples": ["13", 0],
   "trim_amount": ["12", 3]
  }
 },
 "15": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["14", 0],
   "vae": ["3", 0]
  }
 },
 "16": {
  "class_type": "ImageStitch",
  "inputs": {
   "image1": ["6", 0],
   "image2": ["17", 0],
   "direction": "right",
   "match_image_size": true,
   "spacing_width": 0,
   "spacing_color": "black"
  }
 },
 "17": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{REF_IMAGE}}"
  }
 },
 "18": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{REF_IMAGE_2}}"
  }
 },
 "19": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{REF_IMAGE_3}}"
  }
 },
 "20": {
  "class_type": "ImageStitch",
  "inputs": {
   "image1": ["16", 0],
   "image2": ["18", 0],
   "direction": "right",
   "match_image_size": true,
   "spacing_width": 0,
   "spacing_color": "black"
  }
 },
 "21": {
  "class_type": "ImageStitch",
  "inputs": {
   "image1": ["20", 0],
   "image2": ["19", 0],
   "direction": "right",
   "match_image_size": true,
   "spacing_width": 0,
   "spacing_color": "black"
  }
 },
 "25": {
  "class_type": "ResizeAndPadImage",
  "inputs": {
   "image": ["21", 0],
   "target_width": "{{CAM_W}}",
   "target_height": "{{CAM_H}}",
   "padding_color": "white",
   "interpolation": "lanczos"
  }
 },
 "26": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["25", 0],
   "filename_prefix": "{{REFGRID_PREFIX}}"
  }
 },
 "22": {
  "class_type": "OF_DepthBlur",
  "inputs": {
   "image": ["15", 0],
   "depth": ["10", 0],
   "aperture": "{{APERTURE}}",
   "focus_distance": "{{DISTANCE}}",
   "distance": "{{DISTANCE}}",
   "poses_json": ["7", 0]
  }
 },
 "23": {
  "class_type": "VHS_VideoCombine",
  "inputs": {
   "images": ["22", 0],
   "frame_rate": "{{FPS}}",
   "loop_count": 0,
   "filename_prefix": "{{PREFIX}}",
   "format": "video/h264-mp4",
   "save_output": true,
   "pingpong": false
  }
 }
}
