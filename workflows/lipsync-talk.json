    "13",
    0
   ],
   "images.image1": [
    "14",
    0
   ]
  }
 },
 "16": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "15",
    0
   ],
   "channel": "red"
  }
 },
 "17": {
  "class_type": "WanVaceToVideo",
  "inputs": {
   "positive": [
    "4",
    0
   ],
   "negative": [
    "5",
    0
   ],
   "vae": [
    "3",
    0
   ],
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "length": "{{FRAMES}}",
   "batch_size": 1,
   "strength": 1.0,
   "control_video": [
    "12",
    0
   ],
   "control_masks": [
    "16",
    0
   ],
   "reference_image": [
    "12",
    0
   ]
  }
 },
 "18": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "positive": [
    "17",
    0
   ],
   "negative": [
    "17",
    1
   ],
   "latent_image": [
    "17",
    2
   ],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "uni_pc",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "10": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "33",
    0
   ],
   "vae": [
    "3",
    0
   ]
  }
 },
 "33": {
  "class_type": "TrimVideoLatent",
  "inputs": {
   "samples": [
    "18",
    0
   ],
   "trim_amount": [
    "17",
    3
   ]
  }
 },
 "34": {
  "class_type": "OF_MouthMask",
  "inputs": {
   "image": [
    "10",
    0
   ],
   "dilate": 6,
   "feather": 9,
   "resolution": 512
  }
 }
}
