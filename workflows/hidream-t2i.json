{
 "_meta": {
  "name": "HiDream-O1 — text to image (cloud tier, MIT)",
  "placeholders": {
   "PROMPT": "prompt text",
   "NEGATIVE": "negative prompt",
   "WIDTH": "width px (multiple of 32 — the card's reference is 1024-2048)",
   "HEIGHT": "height px (multiple of 32)",
   "SEED": "noise seed",
   "STEPS": "sampler steps (the card's reference is 40-50)",
   "PREFIX": "filename prefix"
  },
  "requires": [
   "hidream_o1_image_fp8_scaled.safetensors (checkpoints — tier C optional manifest)"
  ],
  "nodes": "HiDream-O1-Image full per the official card: the repackaged fp8 checkpoint carries model+clip+vae in one file (CheckpointLoaderSimple), EmptyHiDreamO1LatentImage holds the canvas, plain KSampler (dpmpp_2m_sde, cfg 5). ~8 GB — pod tier."
 },
 "1": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "hidream_o1_image_fp8_scaled.safetensors"
  }
 },
 "2": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["1", 1],
   "text": "{{PROMPT}}"
  }
 },
 "3": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": ["1", 1],
   "text": "{{NEGATIVE}}"
  }
 },
 "4": {
  "class_type": "EmptyHiDreamO1LatentImage",
  "inputs": {
   "width": "{{WIDTH}}",
   "height": "{{HEIGHT}}",
   "batch_size": 1
  }
 },
 "5": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["1", 0],
   "positive": ["2", 0],
   "negative": ["3", 0],
   "latent_image": ["4", 0],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 5.0,
   "sampler_name": "dpmpp_2m_sde",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "6": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["5", 0],
   "vae": ["1", 2]
  }
 },
 "7": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["6", 0],
   "filename_prefix": "{{PREFIX}}"
  }
 }
}
