{
  "_meta": {
    "name": "LTX-2.5 image-to-video",
    "placeholders": {
      "PROMPT": "prompt",
      "NEGATIVE": "negative prompt (encoded into the guiders; distilled cfg is 1.0 so it is a no-op)",
      "INPUT_IMAGE": "first frame / conditioning image",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "FRAMES": "8n+1 (121 ≈ 5s @24fps, 193 ≈ 8s)",
      "FPS": "frame rate",
      "SEED": "noise seed (pass 1; pass 2 refiner seed is fixed 42 like the template)",
      "PREFIX": "filename prefix"
    },
    "requires": [
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors (diffusion_models)",
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors (text_encoders)",
      "ltx-2.5-video-vae-bf16.safetensors (vae)",
      "ltx-2.5-audio-vae-bf16.safetensors (vae)",
      "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors (latent_upscale_models)"
    ],
    "nodes": "core only",
    "notes": "Official ComfyUI LTX-2.5 I2V two-pass recipe (video_ltx2_5_i2v template): input is resized to a 1536px longer edge and LTXVPreprocess(18)-compressed, then LTXVImgToVideoInplace anchors the half-res pass-1 latent (strength 0.7) and the upscaled pass-2 latent (strength 1.0). Same distilled 8-step draft → spatial latent upscale → 4-step refine pipeline as the T2V template; audio track generated jointly and muxed via CreateVideo → SaveVideo."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-bf16.safetensors" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" } },
  "4": { "class_type": "CLIPLoader", "inputs": { "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 0], "text": "{{PROMPT}}" } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 0], "text": "{{NEGATIVE}}" } },
  "7": { "class_type": "LTXVConditioning", "inputs": { "positive": ["5", 0], "negative": ["6", 0], "frame_rate": "{{FPS}}" } },
  "8": { "class_type": "LoadImage", "inputs": { "image": "{{INPUT_IMAGE}}" } },
  "9": { "class_type": "ResizeImageMaskNode", "inputs": { "input": ["8", 0], "resize_type": "scale longer dimension", "resize_type.longer_size": 1536, "scale_method": "lanczos" } },
  "10": { "class_type": "LTXVPreprocess", "inputs": { "image": ["9", 0], "img_compression": 18 } },
  "11": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a/2", "values.a": "{{WIDTH}}" } },
  "12": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a/2", "values.a": "{{HEIGHT}}" } },
  "13": { "class_type": "EmptyLTXVLatentVideo", "inputs": { "width": ["11", 1], "height": ["12", 1], "length": "{{FRAMES}}", "batch_size": 1 } },
  "14": { "class_type": "LTXVImgToVideoInplace", "inputs": { "vae": ["2", 0], "image": ["10", 0], "latent": ["13", 0], "strength": 0.7, "bypass": false } },
  "15": { "class_type": "LTXVEmptyLatentAudio", "inputs": { "audio_vae": ["3", 0], "frames_number": "{{FRAMES}}", "frame_rate": "{{FPS}}", "batch_size": 1 } },
  "16": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["14", 0], "audio_latent": ["15", 0] } },
  "17": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "18": { "class_type": "LTXVDualCFGGuider", "inputs": { "model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1], "video_cfg": 1.0, "audio_cfg": 1.0 } },
  "19": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "20": { "class_type": "ManualSigmas", "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" } },
  "21": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["17", 0], "guider": ["18", 0], "sampler": ["19", 0], "sigmas": ["20", 0], "latent_image": ["16", 0] } },
  "22": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["21", 0] } },
  "23": { "class_type": "LatentUpscaleModelLoader", "inputs": { "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors" } },
  "24": { "class_type": "LTXVLatentUpsampler", "inputs": { "samples": ["22", 0], "upscale_model": ["23", 0], "vae": ["2", 0] } },
  "25": { "class_type": "LTXVImgToVideoInplace", "inputs": { "vae": ["2", 0], "image": ["10", 0], "latent": ["24", 0], "strength": 1.0, "bypass": false } },
  "26": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["25", 0], "audio_latent": ["22", 1] } },
  "27": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "28": { "class_type": "LTXVDualCFGGuider", "inputs": { "model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1], "video_cfg": 1.0, "audio_cfg": 1.0 } },
  "29": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "30": { "class_type": "ManualSigmas", "inputs": { "sigmas": "0.85, 0.7250, 0.4219, 0.0" } },
  "31": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["27", 0], "guider": ["28", 0], "sampler": ["29", 0], "sigmas": ["30", 0], "latent_image": ["26", 0] } },
  "32": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["31", 0] } },
  "33": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["32", 0], "vae": ["2", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 } },
  "34": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["32", 1], "audio_vae": ["3", 0] } },
  "35": { "class_type": "CreateVideo", "inputs": { "images": ["33", 0], "audio": ["34", 0], "fps": "{{FPS}}" } },
  "36": { "class_type": "SaveVideo", "inputs": { "video": ["35", 0], "filename_prefix": "{{PREFIX}}", "format": "auto", "format.codec": "auto" } }
}
