{
  "_meta": {
    "name": "PersonSwap environment window (invert-matte restyle)",
    "placeholders": {
      "PROMPT": "new setting/scene description",
      "NEGATIVE": "negative prompt",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "FRAMES": "8n+1",
      "SEED": "noise seed",
      "STEPS": "2-50 (local default 8)",
      "INPUT_VIDEO": "≤5 s window clip at generation box, comfy input/ filename",
      "REF_IMAGE": "optional setting/style reference for the new environment",
      "PREFIX": "output filename prefix"
    },
    "optional": [
      "REF_IMAGE"
    ],
    "requires": [
      "wan2.1_vace_1.3B_fp16.safetensors",
      "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "wan_2.1_vae.safetensors",
      "birefnet.safetensors (models/birefnet, MIT)",
      "custom-nodes: VideoHelperSuite (VHS_LoadVideo, VHS_VideoCombine), motionfield_nodes (OF_MatteCoverage)"
    ],
    "nodes": "core + VHS + motionfield_nodes",
    "notes": "Environment swap: the grown person matte is INVERTED so VACE regenerates everything except the person — the subject's pixels are preserved while the setting is re-created from the prompt (or the optional setting ref). The control video is NOT the raw frames: a mid-gray EmptyImage plate (WIDTH×HEIGHT×FRAMES, batch matching) is composited under the real frames through the person mask, so VACE encodes real pixels only where the person stands and neutral gray everywhere the room must be rebuilt — the old room can't leak through the reactive region. In 'both' mode the recipe runs the person pass first and feeds its output in, so the matte still shields the now-swapped identity. The person-matte coverage strip and applied matte frame are saved like the person graph — evidence travels with the window."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_vace_1.3B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{PROMPT}}"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{NEGATIVE}}"
    }
  },
  "6": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{{INPUT_VIDEO}}",
      "force_rate": 16,
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": "{{FRAMES}}",
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "7": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REF_IMAGE}}"
    }
  },
  "8": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  },
  "9": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "8",
        0
      ],
      "image": [
        "6",
        0
      ]
    }
  },
  "10": {
    "class_type": "OF_MatteCoverage",
    "inputs": {
      "mask": [
        "9",
        0
      ]
    }
  },
  "11": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "10",
        0
      ],
      "expand": 6,
      "tapered_corners": true
    }
  },
  "12": {
    "class_type": "FeatherMask",
    "inputs": {
      "mask": [
        "11",
        0
      ],
      "left": 8,
      "top": 8,
      "right": 8,
      "bottom": 8
    }
  },
  "13": {
    "class_type": "InvertMask",
    "inputs": {
      "mask": [
        "12",
        0
      ]
    }
  },
  "14": {
    "class_type": "WanVaceToVideo",
    "inputs": {
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{FRAMES}}",
      "batch_size": 1,
      "strength": 1.0,
      "control_video": [
        "24",
        0
      ],
      "control_masks": [
        "13",
        0
      ],
      "reference_image": [
        "7",
        0
      ]
    }
  },
  "15": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "positive": [
        "14",
        0
      ],
      "negative": [
        "14",
        1
      ],
      "latent_image": [
        "14",
        2
      ],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "16": {
    "class_type": "TrimVideoLatent",
    "inputs": {
      "samples": [
        "15",
        0
      ],
      "trim_amount": [
        "14",
        3
      ]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "16",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "18": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "17",
        0
      ],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "{{PREFIX}}",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "save_output": true,
      "pingpong": false
    }
  },
  "19": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "13",
        0
      ]
    }
  },
  "20": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "19",
        0
      ],
      "batch_index": 0,
      "length": 1
    }
  },
  "21": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "20",
        0
      ],
      "filename_prefix": "{{PREFIX}}"
    }
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "10",
        1
      ],
      "filename_prefix": "{{PREFIX}}"
    }
  },
  "23": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": "{{FRAMES}}",
      "color": 8421504
    }
  },
  "24": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "23",
        0
      ],
      "source": [
        "6",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "12",
        0
      ]
    }
  }
}