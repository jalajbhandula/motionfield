{
  "_meta": {
    "name": "LTX-2.5 text-to-video",
    "placeholders": {
      "PROMPT": "prompt",
      "NEGATIVE": "negative prompt (encoded into the guiders; distilled cfg is 1.0 so it is a no-op)",
      "WIDTH": "multiple of 32",
      "HEIGHT": "multiple of 32",
      "FRAMES": "8n+1 (121 ≈ 5s @24fps, 193 ≈ 8s)",
      "FPS": "frame rate",
      "SEED": "noise seed (pass 1; pass 2 refiner seed is fixed 42 like the template)",
      "PREFIX": "filename prefix"
    },
    "requires": [
      "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors (diffusion_models)",
      "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors (text_encoders)",
      "ltx-2.5-video-vae-bf16.safetensors (vae)",
      "ltx-2.5-audio-vae-bf16.safetensors (vae)",
      "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors (latent_upscale_models)"
    ],
    "nodes": "core only",
    "notes": "Official ComfyUI LTX-2.5 T2V two-pass recipe (video_ltx2_5_t2v template): pass 1 samples a half-resolution joint AV latent (distilled 8-step sigma table, LTXVDualCFGGuider with video/audio cfg 1); LTXVLatentUpsampler doubles it with the spatial upscaler, then pass 2 refines at full res on the 4-step table (0.85→0) with a fixed-42 refiner noise. Audio latent rides beside the video latent through both passes, is separated, decoded by the audio VAE and muxed by CreateVideo → SaveVideo (native nodes, no VHS). Negative encode is inert at cfg 1 but stays wired."
  },
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-bf16.safetensors" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" } },
  "4": { "class_type": "CLIPLoader", "inputs": { "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 0], "text": "{{PROMPT}}" } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["4", 0], "text": "{{NEGATIVE}}" } },
  "7": { "class_type": "LTXVConditioning", "inputs": { "positive": ["5", 0], "negative": ["6", 0], "frame_rate": "{{FPS}}" } },
  "8": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a/2", "values.a": "{{WIDTH}}" } },
  "9": { "class_type": "ComfyMathExpression", "inputs": { "expression": "a/2", "values.a": "{{HEIGHT}}" } },
  "10": { "class_type": "EmptyLTXVLatentVideo", "inputs": { "width": ["8", 1], "height": ["9", 1], "length": "{{FRAMES}}", "batch_size": 1 } },
  "11": { "class_type": "LTXVEmptyLatentAudio", "inputs": { "audio_vae": ["3", 0], "frames_number": "{{FRAMES}}", "frame_rate": "{{FPS}}", "batch_size": 1 } },
  "12": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["10", 0], "audio_latent": ["11", 0] } },
  "13": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "14": { "class_type": "LTXVDualCFGGuider", "inputs": { "model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1], "video_cfg": 1.0, "audio_cfg": 1.0 } },
  "15": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "16": { "class_type": "ManualSigmas", "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" } },
  "17": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["13", 0], "guider": ["14", 0], "sampler": ["15", 0], "sigmas": ["16", 0], "latent_image": ["12", 0] } },
  "18": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["17", 0] } },
  "19": { "class_type": "LatentUpscaleModelLoader", "inputs": { "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors" } },
  "20": { "class_type": "LTXVLatentUpsampler", "inputs": { "samples": ["18", 0], "upscale_model": ["19", 0], "vae": ["2", 0] } },
  "21": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["20", 0], "audio_latent": ["18", 1] } },
  "22": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "23": { "class_type": "LTXVDualCFGGuider", "inputs": { "model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1], "video_cfg": 1.0, "audio_cfg": 1.0 } },
  "24": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "25": { "class_type": "ManualSigmas", "inputs": { "sigmas": "0.85, 0.7250, 0.4219, 0.0" } },
  "26": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["22", 0], "guider": ["23", 0], "sampler": ["24", 0], "sigmas": ["25", 0], "latent_image": ["21", 0] } },
  "27": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["26", 0] } },
  "28": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["27", 0], "vae": ["2", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 } },
  "29": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["27", 1], "audio_vae": ["3", 0] } },
  "30": { "class_type": "CreateVideo", "inputs": { "images": ["28", 0], "audio": ["29", 0], "fps": "{{FPS}}" } },
  "31": { "class_type": "SaveVideo", "inputs": { "video": ["30", 0], "filename_prefix": "{{PREFIX}}", "format": "auto", "format.codec": "auto" } }
}
