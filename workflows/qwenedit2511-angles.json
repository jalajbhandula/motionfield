{
 "_meta": {
  "name": "Qwen-Image-Edit-2511 + Multiple-angles LoRA — camera-angle edit (cloud tier, Apache-2.0)",
  "placeholders": {
   "INPUT_IMAGE": "source image filename",
   "PROMPT": "angle instruction (e.g. 'rotate the camera 45 degrees to the left')",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "PREFIX": "filename prefix"
  },
  "requires": [
   "qwen_image_edit_2511_fp8mixed.safetensors (diffusion_models — tier A manifest)",
   "qwen_2.5_vl_7b_fp8_scaled.safetensors (text_encoders)",
   "qwen_image_vae.safetensors (vae)",
   "Qwen-Edit-2509-Multiple-angles.safetensors (loras — tier A manifest)"
  ],
  "nodes": "qwenedit2511-edit's chain plus the dx8152 multiple-angles LoRA (model-only) — the angle rides the prompt ('camera rotates …'), the LoRA turns the edit model toward multi-view. ModelSamplingAuraFlow shift 3.1 + CFGNorm. FluxKontextMultiReferenceLatentMethod (index_timestep_zero) on both conditionings per the ComfyUI 2511 template. ~20 GB fp8 — pod tier."
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "qwen_image_edit_2511_fp8mixed.safetensors",
   "weight_dtype": "default"
  }
 },
 "14": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {
   "model": ["1", 0],
   "lora_name": "Qwen-Edit-2509-Multiple-angles.safetensors",
   "strength_model": 1.0
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
   "type": "qwen_image"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  }
 },
 "4": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{INPUT_IMAGE}}"
  }
 },
 "5": {
  "class_type": "ImageScaleToTotalPixels",
  "inputs": {
   "image": ["4", 0],
   "upscale_method": "lanczos",
   "megapixels": 1.0,
   "resolution_steps": 1
  }
 },
 "6": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": ["2", 0],
   "vae": ["3", 0],
   "image1": ["5", 0],
   "prompt": "{{PROMPT}}"
  }
 },
 "7": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": ["2", 0],
   "vae": ["3", 0],
   "image1": ["5", 0],
   "prompt": ""
  }
 },
 "8": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": ["5", 0],
   "vae": ["3", 0]
  }
 },
 "9": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": ["14", 0],
   "shift": 3.1
  }
 },
 "10": {
  "class_type": "CFGNorm",
  "inputs": {
   "model": ["9", 0],
   "strength": 1.0
  }
 },
 "11": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["10", 0],
   "positive": ["15", 0],
   "negative": ["16", 0],
   "latent_image": ["8", 0],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 2.5,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "12": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["11", 0],
   "vae": ["3", 0]
  }
 },
 "13": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["12", 0],
   "filename_prefix": "{{PREFIX}}"
  }
 },
 "15": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": ["6", 0],
   "reference_latents_method": "index_timestep_zero"
  }
 },
 "16": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": ["7", 0],
   "reference_latents_method": "index_timestep_zero"
  }
 }
}
