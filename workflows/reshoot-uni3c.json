{
  "_meta": {
    "name": "MotionField Re-shoot (cloud) — clip re-shot along a new camera path (DA3 multiview + OF rig + Wan 2.1 I2V 14B + Uni3C)",
    "placeholders": {
      "INPUT_VIDEO": "owned source clip filename",
      "MOVES": "'+'-joined trajectory stack (1-3 video-capable catalog ids)",
      "PROMPT": "scene/style prompt",
      "NEGATIVE": "negative prompt",
      "STRENGTH": "trajectory strength 0.25-2",
      "DISTANCE": "subject distance, metres (rescales DA3 world units)",
      "DURATION": "source clip length, seconds (= (FRAMES-1)/FPS)",
      "WIDTH": "output width px (multiple of 16, source aspect)",
      "HEIGHT": "output height px (multiple of 16, source aspect)",
      "FRAMES": "source frame count — the video stream's packet probe (load cap)",
      "PAD_FRAMES": "FRAMES rounded up to 4n+1 for the Wan latent",
      "DA3_RES": "DA3 multiview processing resolution (multiple of 14)",
      "FPS": "source fps — force_rate AND output frame_rate (frame-exact)",
      "SEED": "noise seed",
      "STEPS": "sampler steps",
      "PREFIX": "filename prefix"
    },
    "requires": [
      "wan2.1_i2v_480p_14B_fp8_scaled.safetensors (diffusion_models — tier A manifest)",
      "wan2.1_uni3c_controlnet.pth (model_patches — tier A manifest)",
      "umt5_xxl_fp8_e4m3fn_scaled.safetensors (text_encoders)",
      "wan_2.1_vae.safetensors (vae)",
      "clip_vision_h.safetensors (clip_vision)",
      "depth_anything_3_base.safetensors (geometry_estimation)",
      "custom-nodes: VideoHelperSuite (VHS_LoadVideo, VHS_VideoCombine)",
      "custom-nodes: motionfield_nodes (OF_DA3Poses, OF_Trajectory, OF_CameraRig)",
      "birefnet.safetensors (upscale_models/background removal — tier A manifest)"
    ],
    "nodes": "Uni3C's camera control is carried by the rendered video — so the graph renders the source clip through the NEW path and feeds THAT as render_video. VHS_LoadVideo caps at FRAMES; DA3-Base multiview recovers per-frame depth + source camera poses; OF_DA3Poses rescales to metres; OF_Trajectory composes the new path anchored on the source's frame-0 camera (the source's own move is replaced), its exact pose count coming from OF_DA3Poses.frame_count — the decoded batch, not the container duration; OF_CameraRig splats each frame through its source pose into the new path (pad_to reaches 4n+1); the BiRefNet matte re-places the moving subject as a billboard where the new camera puts it. WanImageToVideo conditions on the rig's frame 0; the decode is trimmed to that same decoded count and muxed at the source fps WITH the source audio track. UNVERIFIED: the repo's ComfyUI validates this graph structurally; it has never rendered on a real GPU — bring your own."
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.1_i2v_480p_14B_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{PROMPT}}"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        0
      ],
      "text": "{{NEGATIVE}}"
    }
  },
  "6": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{{INPUT_VIDEO}}",
      "force_rate": "{{FPS}}",
      "custom_width": "{{WIDTH}}",
      "custom_height": "{{HEIGHT}}",
      "frame_load_cap": "{{FRAMES}}",
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "7": {
    "class_type": "LoadDA3Model",
    "inputs": {
      "model_name": "depth_anything_3_base.safetensors",
      "weight_dtype": "default"
    }
  },
  "8": {
    "class_type": "OF_DA3Windowed",
    "inputs": {
      "da3_model": [
        "7",
        0
      ],
      "image": [
        "6",
        0
      ],
      "resolution": "{{DA3_RES}}",
      "resize_method": "upper_bound_resize",
      "ref_view_strategy": "saddle_balanced",
      "pose_method": "cam_dec",
      "window": 10,
      "overlap": 4
    }
  },
  "9": {
    "class_type": "OF_DA3Poses",
    "inputs": {
      "da3_geometry": [
        "8",
        0
      ],
      "fps": "{{FPS}}",
      "distance": "{{DISTANCE}}",
      "process_res": "{{DA3_RES}}",
      "resize_method": "upper_bound_resize",
      "min_confidence": 0.0
    }
  },
  "10": {
    "class_type": "OF_Trajectory",
    "inputs": {
      "trajectory": "locked-off",
      "moves": "{{MOVES}}",
      "strength": "{{STRENGTH}}",
      "duration": "{{DURATION}}",
      "fps": "{{FPS}}",
      "seed": "{{SEED}}",
      "target": "auto",
      "layer": "auto",
      "post": "auto",
      "subject_class": "person",
      "distance": "{{DISTANCE}}",
      "fov": 40,
      "frames": [
        "9",
        2
      ],
      "anchor": [
        "9",
        0
      ]
    }
  },
  "11": {
    "class_type": "OF_CameraRig",
    "inputs": {
      "source": [
        "6",
        0
      ],
      "depth": [
        "9",
        1
      ],
      "poses_json": [
        "10",
        0
      ],
      "src_poses_json": [
        "9",
        0
      ],
      "near": 0.05,
      "hole_dilate": 6,
      "subject_mode": "billboard",
      "hole_feather": 2,
      "distance": "{{DISTANCE}}",
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "depth_mode": "metres",
      "pad_to": "{{PAD_FRAMES}}",
      "subject_mask": [
        "23",
        0
      ],
      "hole_clamp": 0.6
    }
  },
  "12": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "batch_index": 0,
      "length": 1
    }
  },
  "13": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "14": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": [
        "13",
        0
      ],
      "image": [
        "12",
        0
      ],
      "crop": "none"
    }
  },
  "15": {
    "class_type": "ModelPatchLoader",
    "inputs": {
      "name": "wan2.1_uni3c_controlnet.pth"
    }
  },
  "16": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "length": "{{PAD_FRAMES}}",
      "batch_size": 1,
      "clip_vision_output": [
        "14",
        0
      ],
      "start_image": [
        "12",
        0
      ]
    }
  },
  "17": {
    "class_type": "WanUni3CControlnetApply",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "model_patch": [
        "15",
        0
      ],
      "vae": [
        "3",
        0
      ],
      "render_video": [
        "11",
        0
      ],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "18": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "17",
        0
      ],
      "positive": [
        "16",
        0
      ],
      "negative": [
        "16",
        1
      ],
      "latent_image": [
        "16",
        2
      ],
      "seed": "{{SEED}}",
      "steps": "{{STEPS}}",
      "cfg": 6.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "19": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "18",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "20": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "19",
        0
      ],
      "batch_index": 0,
      "length": [
        "9",
        2
      ]
    }
  },
  "21": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "20",
        0
      ],
      "audio": [
        "22",
        0
      ],
      "frame_rate": "{{FPS}}",
      "loop_count": 0,
      "filename_prefix": "{{PREFIX}}",
      "format": "video/h264-mp4",
      "save_output": true,
      "pingpong": false
    }
  },
  "22": {
    "class_type": "OF_PlateAudio",
    "inputs": {
      "video": "{{INPUT_VIDEO}}",
      "start_time": 0,
      "duration": 0
    }
  },
  "23": {
    "class_type": "RemoveBackground",
    "inputs": {
      "bg_removal_model": [
        "24",
        0
      ],
      "image": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "Moving-subject matte — the rig copies these pixels through unsmashed"
    }
  },
  "24": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    }
  }
}
