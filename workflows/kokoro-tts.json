{
  "_meta": {
    "name": "Kokoro-82M text-to-speech",
    "placeholders": {
      "PROMPT": "text to speak",
      "VOICE": "kokoro voice id (af_heart, am_adam, bf_emma, ...)",
      "SPEED": "speech speed 0.5-2.0",
      "PREFIX": "filename prefix"
    },
    "requires": [
      "comfyui-kokoro (stavsap)"
    ],
    "nodes": "custom (KokoroSpeaker + KokoroGenerator) + core SaveAudio"
  },
  "1": {
    "class_type": "KokoroSpeaker",
    "inputs": {
      "speaker_name": "{{VOICE}}"
    }
  },
  "2": {
    "class_type": "KokoroGenerator",
    "inputs": {
      "text": "{{PROMPT}}",
      "speaker": ["1", 0],
      "speed": "{{SPEED}}",
      "lang": "English"
    }
  },
  "3": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": ["2", 0],
      "filename_prefix": "{{PREFIX}}"
    }
  }
}
