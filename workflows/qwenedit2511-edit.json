{
 "_meta": {
  "name": "Qwen-Image-Edit-2511 — instruction-based image edit (cloud tier, Apache-2.0)",
  "placeholders": {
   "INPUT_IMAGE": "source image filename",
   "PROMPT": "edit instruction",
   "SEED": "noise seed",
   "STEPS": "sampler steps",
   "PREFIX": "filename prefix"
  },
  "requires": [
   "qwen_image_edit_2511_fp8mixed.safetensors (diffusion_models — tier A manifest)",
   "qwen_2.5_vl_7b_fp8_scaled.safetensors (text_encoders)",
   "qwen_image_vae.safetensors (vae)"
  ],
  "nodes": "Qwen-Image-Edit-2511 per the official card — same shape as the 2509 graph but the Plus text encoder (TextEncodeQwenImageEditPlus carries the image into the conditioning; the bare TextEncodeQwenImageEdit belongs to 2509 and ignores its text). ModelSamplingAuraFlow shift 3.1 + CFGNorm like the 2509 fp8 recipe. FluxKontextMultiReferenceLatentMethod (index_timestep_zero) on both conditionings per the ComfyUI 2511 template. ~20 GB fp8 — pod tier."
 },
 "1": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "qwen_image_edit_2511_fp8mixed.safetensors",
   "weight_dtype": "default"
  }
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
   "type": "qwen_image"
  }
 },
 "3": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  }
 },
 "4": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{INPUT_IMAGE}}"
  }
 },
 "5": {
  "class_type": "FluxKontextImageScale",
  "inputs": {
   "image": ["4", 0]
  }
 },
 "6": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": ["2", 0],
   "vae": ["3", 0],
   "image1": ["5", 0],
   "prompt": "{{PROMPT}}"
  }
 },
 "7": {
  "class_type": "TextEncodeQwenImageEditPlus",
  "inputs": {
   "clip": ["2", 0],
   "vae": ["3", 0],
   "image1": ["5", 0],
   "prompt": ""
  }
 },
 "8": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": ["5", 0],
   "vae": ["3", 0]
  }
 },
 "9": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": ["1", 0],
   "shift": 3.1
  }
 },
 "10": {
  "class_type": "CFGNorm",
  "inputs": {
   "model": ["9", 0],
   "strength": 1.0
  }
 },
 "11": {
  "class_type": "KSampler",
  "inputs": {
   "model": ["10", 0],
   "positive": ["14", 0],
   "negative": ["15", 0],
   "latent_image": ["8", 0],
   "seed": "{{SEED}}",
   "steps": "{{STEPS}}",
   "cfg": 4.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
  }
 },
 "12": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": ["11", 0],
   "vae": ["3", 0]
  }
 },
 "13": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["12", 0],
   "filename_prefix": "{{PREFIX}}"
  }
 },
 "14": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": ["6", 0],
   "reference_latents_method": "index_timestep_zero"
  }
 },
 "15": {
  "class_type": "FluxKontextMultiReferenceLatentMethod",
  "inputs": {
   "conditioning": ["7", 0],
   "reference_latents_method": "index_timestep_zero"
  }
 }
}
