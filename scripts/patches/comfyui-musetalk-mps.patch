+# MotionField patch: the upstream pack drives landmark detection through
+# mmpose/mmcv (no usable wheels on Apple Silicon / py3.14) and face bboxes
+# through S3FD (research-only weights). Both are replaced by the Apache-2.0
+# DWPose ONNX pipeline vendored under musetalk/utils/dwpose_onnx/ — the same
+# dw-ll_ucoco_384 wholebody model, same 68-point face landmark layout,
+# plain onnxruntime (CUDA when available, else CoreML/CPU).
+_dwpose = None
+def _dwpose_weight(filename):
+    """DWPose ONNX weights (Apache-2.0, HF yzd-v/DWPose) — setup-musetalk.sh
+    stages them under the MuseTalk ckpt dir; download only as a last resort."""
+    local = os.path.join(MuseVCheckPointDir, "dwpose", filename)
+    if os.path.exists(local):
+        return local
+    from huggingface_hub import hf_hub_download
+    return hf_hub_download("yzd-v/DWPose", filename)
+
+def _ort_providers():
+    # CUDA first: CPU-only sessions left the GPU idle for ~7 s per frame
+    # (YOLOX + DWPose on every frame). OF_DWPOSE_PROVIDER overrides, as in
+    # motionfield_nodes/nodes_pose.py.
+    import onnxruntime as ort
+    override = os.environ.get("OF_DWPOSE_PROVIDER")
+    if override:
+        return [p.strip() for p in override.split(",") if p.strip()]
+    have = ort.get_available_providers()
+    if "CUDAExecutionProvider" in have and hasattr(ort, "preload_dlls"):
+        try:  # reuse the CUDA/cuDNN torch already loaded
+            ort.preload_dlls()
+        except Exception:
+            pass
+    return [p for p in ("CUDAExecutionProvider", "CoreMLExecutionProvider", "CPUExecutionProvider") if p in have]
+
+def _pose_model():
+    global _dwpose
+    if _dwpose is None:
+        from musetalk.utils.dwpose_onnx import Wholebody
+        _dwpose = Wholebody(_dwpose_weight("yolox_l.onnx"),
+                            _dwpose_weight("dw-ll_ucoco_384.onnx"),
+                            providers=_ort_providers())
+    return _dwpose
+
+MIN_KP_SCORE = 0.3
+
+def _face_detect(frame):
+    """One YOLOX+DWPose ONNX pass -> (68 face landmarks | None, fallback box | None).
+
+    Frames arrive BGR (cv2) — converted to RGB for the ONNX models. Keypoints
+    scoring <= MIN_KP_SCORE keep their 68-slot layout but are NaN-marked as
+    missing, so callers index positions, not counts. The second return is the
+    min/max box over the *valid* points, extended half a face-height upward to
+    cover the forehead — consumed only when the landmark-adjusted box below
+    comes out degenerate."""
+    wb = _pose_model()  # a load failure raises here — loud, not a silent no-face
+    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+    try:
+        keypoints, scores = wb(rgb)
+    except Exception as e:
+        print("dwpose onnx inference failed:", e)
+        return None, None
+    if keypoints is None or len(keypoints) == 0:
+        return None, None
+    pts = keypoints[0][23:91].astype(np.float64)  # wholebody face block — 68 pts
+    conf = scores[0][23:91]
+    pts = np.where((conf > MIN_KP_SCORE)[:, None], pts, np.nan)
+    valid = np.isfinite(pts[:, 0])
+    if int(valid.sum()) < 4:
+        return None, None
+    h, w = frame.shape[:2]
+    x1, x2 = int(np.nanmin(pts[valid, 0])), int(np.nanmax(pts[valid, 0]))
+    y1, y2 = int(np.nanmin(pts[valid, 1])), int(np.nanmax(pts[valid, 1]))
+    return pts, (max(0, x1), max(0, y1 - (y2 - y1) // 2), min(w, x2), min(h, y2))
+
+def _landmark_bbox(face_land_mark, f, upperbondrange, average_range_minus, average_range_plus):
+    """Landmark-adjusted crop box (caller reuses f when it comes out degenerate).
+
+    When the nose-ridge points (28/29/30 in the 68-pt layout) are all present we
+    keep upstream's forehead estimate anchored on point 29; when any is missing
+    we fall back to the box built from the valid keypoints."""
+    valid = np.isfinite(face_land_mark[:, 0])
+    pts = face_land_mark[valid]
