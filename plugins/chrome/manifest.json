{
  "manifest_version": 3,
  "name": "MotionField",
  "version": "0.1.0",
  "description": "Send images and videos on the web to your local MotionField studio as generation jobs.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "MotionField" }
}
