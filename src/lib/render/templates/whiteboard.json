  "params": [
    { "id": "markerHue", "label": "Marker hue", "min": 0, "max": 360, "step": 1, "default": 12, "bind": "arrow.props.hue" },
    { "id": "strokeW", "label": "Stroke width", "min": 2, "max": 14, "step": 0.5, "default": 6, "bind": "circle.props.width" }
  ]
