{
  "version": 1,
  "width": 1280,
  "height": 720,
  "fps": 24,
  "duration": 3,
  "seed": 3344,
  "background": { "color": "#11141d" },
  "camera": {
    "fov": 50,
    "keyframes": [{ "t": 0, "position": [0, 0, 1000], "target": [0, 0, 0] }]
  },
  "layers": [
    {
      "id": "fig",
      "type": "group",
      "transform": { "position": [-260, -40, 0] },
      "props": {
        "children": [
          {
            "id": "head",
            "type": "sphere",
            "props": { "radius": 42, "hue": 48, "metalness": 0.1, "roughness": 0.7, "segments": 32 },
            "transform": { "position": [0, 150, 0] }
          },
          {
            "id": "body",
            "type": "line",
            "props": { "points": [[0, 100, 0], [0, 20, 0], [0, -60, 0]], "width": 12, "color": "#e8ecf6" }
          },
          {
            "id": "arm-l",
            "type": "line",
            "props": { "points": [[0, 0, 0], [-70, -55, 0]], "width": 11, "color": "#e8ecf6" },
            "transform": { "position": [0, 80, 0] },
            "keyframes": [
              { "t": 0.3, "path": "rotation.z", "value": 0 },
              { "t": 1.0, "path": "rotation.z", "value": -0.7, "ease": "easeInOut" },
              { "t": 1.7, "path": "rotation.z", "value": 0.5, "ease": "easeInOut" },
              { "t": 2.5, "path": "rotation.z", "value": 0, "ease": "easeInOut" }
            ]
          },
          {
            "id": "arm-r",
            "type": "line",
            "props": { "points": [[0, 0, 0], [78, -40, 0]], "width": 11, "color": "#e8ecf6" },
            "transform": { "position": [0, 80, 0] },
            "keyframes": [
              { "t": 0.5, "path": "rotation.z", "value": 0 },
              { "t": 1.3, "path": "rotation.z", "value": 0.9, "ease": "easeInOut" },
              { "t": 2.0, "path": "rotation.z", "value": -0.4, "ease": "easeInOut" },
              { "t": 2.6, "path": "rotation.z", "value": 0, "ease": "easeInOut" }
            ]
          },
          {
            "id": "leg-l",
            "type": "line",
            "props": { "points": [[0, 0, 0], [-55, -95, 0]], "width": 11, "color": "#e8ecf6" },
            "transform": { "position": [0, -60, 0] }
          },
          {
            "id": "leg-r",
            "type": "line",
            "props": { "points": [[0, 0, 0], [55, -95, 0]], "width": 11, "color": "#e8ecf6" },
            "transform": { "position": [0, -60, 0] }
          }
        ]
      },
      "keyframes": [
        { "t": 0, "path": "position.y", "value": -40 },
        { "t": 0.8, "path": "position.y", "value": 10, "ease": "spring" },
        { "t": 1.6, "path": "position.y", "value": -40, "ease": "spring" },
        { "t": 2.4, "path": "position.y", "value": 0, "ease": "spring" }
      ]
    },
    {
      "id": "idea",
      "type": "text3d",
      "props": { "text": "STEP 1", "size": 84, "depth": 18, "bevelSize": 2, "color": "#f2c14e", "metalness": 0.3, "roughness": 0.5, "stagger": { "delay": 0.06, "from": "start" } },
      "transform": { "position": [200, 120, 0] },
      "keyframes": [
        { "t": 0.4, "path": "position.y", "value": -60 },
        { "t": 1.0, "path": "position.y", "value": 0, "ease": "spring" },
        { "t": 0.4, "path": "opacity", "value": 0 },
        { "t": 1.0, "path": "opacity", "value": 1 }
      ]
    },
    {
      "id": "caption",
      "type": "text",
      "props": { "text": "draw it, then explain it", "size": 40, "weight": 500, "color": "#aeb8d4" },
      "transform": { "position": [200, -40, 0] },
      "keyframes": [
        { "t": 1.6, "path": "opacity", "value": 0 },
        { "t": 2.1, "path": "opacity", "value": 1 }
      ]
    }
  ],
  "params": [
    { "id": "accentHue", "label": "Accent hue", "min": 0, "max": 360, "step": 1, "default": 48, "bind": "head.props.hue" },
    { "id": "figZoom", "label": "Figure zoom", "min": 0.7, "max": 1.4, "step": 0.02, "default": 1, "bind": "fig.scale" }
  ]
}
