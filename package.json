{
  "name": "motionfield",
  "version": "0.1.0",
  "private": true,
  "description": "MotionField \u2014 an open-source creative studio built on ComfyUI.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/sdk-ts/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p packages/mcp/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:names": "node scripts/check-names.mjs --baseline tests/fixtures/names-baseline.txt",
    "audit:licenses": "npx tsx scripts/license-audit.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:up": "docker compose up -d db",
    "start:local": "sh start.sh",
    "auth:schema": "npx auth@latest generate",
    "demo:dry": "tsx scripts/demo/dry.ts",
    "demo:record": "tsx scripts/demo/record-live.ts",
    "health": "node --experimental-strip-types scripts/doctor.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@comfyorg/sdk": "0.5.0",
    "@electric-sql/pglite": "0.5.8",
    "@gltf-transform/core": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "better-auth": "1.7.7",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "0.45.4",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "opentype.js": "^1.3.4",
    "pg": "8.23.1",
    "phaser": "^4.2.1",
    "playwright-core": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "stripe": "^22.6.0",
    "three": "^0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.15.0"
}
