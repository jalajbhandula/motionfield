{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.mts",
    "../cli/src/util.mts",
    "../sdk-ts/src/index.ts",
    "../../src/lib/api/net-guard.ts",
    "../../src/lib/api/upload-rules.ts"
  ]
}
