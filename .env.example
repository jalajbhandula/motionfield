# --- Database ---
# One database: Postgres in Docker. `docker compose up -d db` or `sh start.sh`.
DATABASE_URL=postgres://motionfield:motionfield@127.0.0.1:5432/motionfield

# --- Auth (better-auth) ---
# Generate: openssl rand -base64 32   (min 32 chars)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Extra origins allowed to call the auth API — comma list. Add here any origin
# you browse the app from that isn't BETTER_AUTH_URL (127.0.0.1, LAN IP, tunnel).
# MOTIONFIELD_TRUSTED_ORIGINS=http://127.0.0.1:3000

# Social sign-in (optional — Google/Apple/Microsoft)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_APPLE_CLIENT_ID=
BETTER_AUTH_APPLE_CLIENT_SECRET=
BETTER_AUTH_MICROSOFT_CLIENT_ID=
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=
# MOTIONFIELD_HOSTED=0   # 1 = hosted deployment: webhooks may not target private networks

# --- Generation provider: "comfy" | "mock" (mock = canned outputs for dev/tests) ---
GENERATION_PROVIDER=comfy

# Comfy Developer Platform — workflows run through the official Comfy SDK (Comfy API v2).
#   Self-hosted (default, free): run ComfyUI on :8188, then `comfy-api-proxy start`
#     (pip install comfy-api-proxy) which serves the v2 API on :8189. Leave the key blank.
#   Comfy Cloud: COMFY_BASE_URL=https://cloud.comfy.org + COMFY_API_KEY (paid plan).
COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_API_KEY=
# Per-deployment weight overrides — JSON map of workflow filename -> installed filename.
# Lets the same graphs run lighter weights locally (e.g. VACE 1.3B on a laptop,
# VACE 14B in the cloud) without editing workflow JSONs.
COMFY_MODEL_MAP={}
# Public URL of THIS app, reachable by the Comfy server, used to fetch input media.
PUBLIC_BASE_URL=http://localhost:3000

# Orchestrator LLM — provider presets + per-task routing. Default local setup is
# Ollama running the open-weights Qwen3.5 9B planner:
#   ollama serve && ollama pull qwen3.5:9b
# Presets (all self-hosted, open-weights): ollama | lmstudio | llamacpp | vllm
#          | custom (your own OpenAI-compatible or Ollama server)
# With every LLM_* var unset the agent uses its deterministic fallback planner.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
# Endpoint key — local providers need none; only for a self-hosted server
# behind a token. Sent only to the LLM_PROVIDER service:
LLM_API_KEY=
# Per-provider key for LLM_TASK_* routes — LLM_API_KEY_<PROVIDER ID>, e.g.:
# LLM_API_KEY_CUSTOM=
# Optional: override the preset's base URL — or, with LLM_PROVIDER unset, any
# OpenAI-compatible /chat/completions endpoint (legacy single-endpoint mode).
LLM_BASE_URL=
# Optional: per-task routing as <provider>:<model> — tasks: planner | writer |
# vision | coder | enhancer | judge. Unset tasks fall back to the global route.
# LLM_TASK_PLANNER=ollama:qwen3.5:9b
# LLM_TASK_WRITER=
# LLM_TASK_VISION=
# LLM_TASK_CODER=
# LLM_TASK_ENHANCER=
# LLM_TASK_JUDGE=
# Wire for a custom endpoint (openai-chat | ollama):
# LLM_WIRE=openai-chat
# Offline mode — refuse every non-loopback LLM endpoint:
# MOTIONFIELD_OFFLINE=0
# Hosted deployments — refuse local LLM providers and user-supplied
# http/private endpoints outright:
# MOTIONFIELD_HOSTED=0

# Stripe payments (optional — without these, billing grants credits instantly in dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional fixed price IDs (create Products per plan in the Stripe dashboard):
# STRIPE_PRICE_BASIC_MONTHLY=price_...
# STRIPE_PRICE_BASIC_ANNUAL=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_MAX_MONTHLY=price_...
# STRIPE_PRICE_MAX_ANNUAL=price_...
# Enable only after you have an active Stripe Tax registration:
STRIPE_AUTOMATIC_TAX=false

# Resend transactional email (optional — logs to console without it)
RESEND_API_KEY=
RESEND_FROM=MotionField <noreply@yourdomain.com>

# Optional: keep audio on the Mac while COMFY_BASE_URL points at the pod.
# Uploaded audio and recipe sub-jobs use this server; image/video uses the main one.
# COMFY_AUDIO_BASE_URL=http://127.0.0.1:8189
# COMFY_AUDIO_API_KEY=
